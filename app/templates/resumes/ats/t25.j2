{# ATS Template 25 — Dense Career · single column · steel blue, built for long multi-role histories
   Ported from block <!-- 25 --> / id="t25" of "ATS Resume Templates Coded.dc.html".
   ATS-safe invariants (16-25): single linear column; canonical single-word
   headings only; label tracking <= 1.2px; skill rows "name — Level" with a real
   em-dash as selectable text; plain-hyphen date ranges. Locked spec: ink
   #15191C, steel blue #2A5A78, tint #4F585E. Montserrat for the 36px name, the
   section labels and metric numerals; Open Sans body at a tight 1.5-ish leading
   so long histories fit. One 2px steel rule under the header. No fills.

   Divergences from ref (dense-career reference):
     1. Palette locked to ink #15191C + steel blue #2A5A78.
     2. Type — Montserrat headline + Open Sans body.
     3. Contact on one line, pipe-separated.
     4. Ref ends at Certifications; Tools and Languages, when present, get their
        own canonical single-word sections.
     5. Section gap 24->13, Key Achievements leading 1.95->1.6 to seat the shared
        sample once Tools + Languages are added. #}
{% macro sh(label) %}
<div style="font-family:Montserrat,sans-serif; font-weight:700; font-size:12px; letter-spacing:1.2px; text-transform:uppercase; color:#2A5A78; margin-bottom:5px;">{{ label }}</div>
{% endmacro %}
<div class="tpl" style="box-sizing:border-box; width:850px; height:1100px; background:#ffffff; padding:44px 56px; display:flex; flex-direction:column; gap:13px; font-family:'Open Sans',sans-serif; color:#15191C;">

  <div style="border-bottom:2px solid #2A5A78; padding-bottom:10px;">
    <div style="font-family:Montserrat,sans-serif; font-weight:800; font-size:36px; line-height:1.04; letter-spacing:-0.6px;">{{ r.name }}</div>
    {% if r.title %}<div style="font-size:12.5px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:#2A5A78; margin-top:7px;">{{ r.title }}</div>{% endif %}
    {% set c = r.contact %}{% set bits = [] %}
    {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
    {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
    {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
    {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
    {% for s in c.social %}{% if s.label %}{% set _ = bits.append(s.label) %}{% endif %}{% endfor %}
    {% if bits %}<div style="font-size:11.5px; color:#4F585E; margin-top:7px; line-height:1.6;">{{ bits | join(" | ") }}</div>{% endif %}
  </div>

  {% if r.summary %}
  <div>{{ sh(t("Summary")) }}
    <p style="margin:0; font-size:11.5px; line-height:1.55;">{{ r.summary }}</p>
  </div>
  {% endif %}

  {% if r.achievements %}
  <div>{{ sh(t("Key Achievements")) }}
    <div style="font-size:11.5px; line-height:1.6;">
      {% for a in r.achievements %}
      <div><span style="font-family:Montserrat,sans-serif; font-weight:800; color:#2A5A78;">{{ a.metric }}</span> — {{ a.label }}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.experience %}
  <div>{{ sh(t("Experience")) }}
    <div style="display:flex; flex-direction:column; gap:11px;">
      {% for job in r.experience %}
      <div>
        <div style="display:flex; justify-content:space-between; align-items:baseline; gap:14px;">
          <span style="font-weight:700; font-size:12.5px;">{{ job.role }}</span>
          {% if job.start or job.end %}<span style="font-size:11px; color:#4F585E; white-space:nowrap;">{{ job.start }}{% if job.start and job.end %} - {% endif %}{{ job.end }}</span>{% endif %}
        </div>
        {% if job.company or job.location %}<div style="font-size:11.5px; color:#2A5A78; margin:1px 0 3px;">{{ job.company }}{% if job.company and job.location %}, {% endif %}{{ job.location }}</div>{% endif %}
        {% if job.bullets %}
        <ul style="margin:0; padding-inline-start:16px; font-size:11.5px; line-height:1.52;">
          {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.skills %}
  <div>{{ sh(t("Skills")) }}
    <div style="display:flex; flex-direction:column; gap:4px; font-size:11.5px;">
      {% for sk in r.skills %}
      <div style="display:flex;"><span style="width:230px; flex-shrink:0;">{{ sk.name }}</span><span style="font-weight:700; color:#2A5A78;">— {{ sk.level }}</span></div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.education %}
  <div>{{ sh(t("Education")) }}
    <div style="font-size:11.5px; line-height:1.55;">
      {% for ed in r.education %}
      <div><b>{{ ed.degree }}</b>{% if ed.school %} — {{ ed.school }}{% endif %}{% if ed.start or ed.end %}, {{ ed.start }}{% if ed.start and ed.end %} - {% endif %}{{ ed.end }}{% endif %}{% if ed.gpa %} · {{ t('GPA') }} {{ ed.gpa }}{% endif %}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.recognition %}
  <div>{{ sh(t("Certifications")) }}
    <div style="font-size:11.5px; line-height:1.55;">
      {% for rec in r.recognition %}<div>{{ rec.title }}{% if rec.detail %} — {{ rec.detail }}{% endif %}</div>{% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.tools %}
  <div>{{ sh(t("Tools")) }}
    <div style="font-size:11.5px; line-height:1.55;">{{ r.tools | join(" · ") }}</div>
  </div>
  {% endif %}

  {% if r.languages %}
  <div>{{ sh(t("Languages")) }}
    <div style="font-size:11.5px; line-height:1.55;">{% for l in r.languages %}{{ l.name }} — {{ l.level }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
  </div>
  {% endif %}
</div>
