{# ATS Template 20 — Centred Serif · single column · burgundy accent, centred masthead, quiet register
   Ported from block <!-- 20 --> / id="t20" of "ATS Resume Templates Coded.dc.html".
   ATS-safe invariants (16-25): single linear column; canonical single-word
   headings only; label tracking <= 1.2px; skill rows "name — Level" with a real
   em-dash as selectable text; plain-hyphen date ranges. Locked spec: ink
   #1B1517, burgundy #6E1F2B, tint #5A5054. Merriweather for the centred name and
   the experience role lines; Inter for section labels, contact, dates and body
   copy. One 1px burgundy rule under the centred masthead. No fills.

   Divergences from ref (centred-serif reference):
     1. Palette locked to ink #1B1517 + burgundy #6E1F2B.
     2. Type — Merriweather headline + Inter body.
     3. Contact on one centred line, pipe-separated.
     4. Ref ends at Certifications; Tools and Languages, when present, get their
        own canonical single-word sections.
     5. Section gap 28->14 to seat the shared sample once Tools + Languages are
        added. #}
{% macro ih(label) %}
<div style="font-family:Inter,sans-serif; font-weight:700; font-size:12px; letter-spacing:1.2px; text-transform:uppercase; color:#6E1F2B; margin-bottom:6px;">{{ label }}</div>
{% endmacro %}
<div class="tpl" style="box-sizing:border-box; width:850px; height:1100px; background:#ffffff; padding:48px 78px; display:flex; flex-direction:column; gap:14px; font-family:Merriweather,serif; color:#1B1517;">

  <div style="text-align:center; border-bottom:1px solid #6E1F2B; padding-bottom:13px;">
    <div style="font-weight:700; font-size:34px; line-height:1.15;">{{ r.name }}</div>
    {% if r.title %}<div style="font-family:Inter,sans-serif; font-size:12px; font-weight:600; letter-spacing:1.2px; text-transform:uppercase; color:#6E1F2B; margin-top:9px;">{{ r.title }}</div>{% endif %}
    {% set c = r.contact %}{% set bits = [] %}
    {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
    {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
    {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
    {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
    {% for s in c.social %}{% if s.label %}{% set _ = bits.append(s.label) %}{% endif %}{% endfor %}
    {% if bits %}<div style="font-family:Inter,sans-serif; font-size:11.5px; color:#5A5054; margin-top:8px; line-height:1.6;">{{ bits | join(" | ") }}</div>{% endif %}
  </div>

  {% if r.summary %}
  <div>{{ ih(t("Summary")) }}
    <p style="margin:0; font-size:11.5px; line-height:1.6;">{{ r.summary }}</p>
  </div>
  {% endif %}

  {% if r.achievements %}
  <div>{{ ih(t("Key Achievements")) }}
    <div style="font-family:Inter,sans-serif; font-size:11.5px; line-height:1.62;">
      {% for a in r.achievements %}
      <div><span style="font-weight:700; color:#6E1F2B;">{{ a.metric }}</span> — {{ a.label }}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.experience %}
  <div>{{ ih(t("Experience")) }}
    <div style="display:flex; flex-direction:column; gap:10px;">
      {% for job in r.experience %}
      <div>
        <div style="display:flex; justify-content:space-between; align-items:baseline; gap:14px;">
          <span style="font-weight:700; font-size:12.5px;">{{ job.role }}</span>
          {% if job.start or job.end %}<span style="font-family:Inter,sans-serif; font-size:11px; color:#5A5054; white-space:nowrap;">{{ job.start }}{% if job.start and job.end %} - {% endif %}{{ job.end }}</span>{% endif %}
        </div>
        {% if job.company or job.location %}<div style="font-family:Inter,sans-serif; font-size:11.5px; color:#6E1F2B; margin:2px 0 4px;">{{ job.company }}{% if job.company and job.location %}, {% endif %}{{ job.location }}</div>{% endif %}
        {% if job.bullets %}
        <ul style="margin:0; padding-inline-start:17px; font-family:Inter,sans-serif; font-size:11.5px; line-height:1.58;">
          {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.skills %}
  <div>{{ ih(t("Skills")) }}
    <div style="display:flex; flex-direction:column; gap:4px; font-family:Inter,sans-serif; font-size:11.5px;">
      {% for sk in r.skills %}
      <div style="display:flex;"><span style="width:230px; flex-shrink:0;">{{ sk.name }}</span><span style="font-weight:700; color:#6E1F2B;">— {{ sk.level }}</span></div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.education %}
  <div>{{ ih(t("Education")) }}
    <div style="font-family:Inter,sans-serif; font-size:11.5px; line-height:1.6;">
      {% for ed in r.education %}
      <div><b>{{ ed.degree }}</b>{% if ed.school %} — {{ ed.school }}{% endif %}{% if ed.start or ed.end %}, {{ ed.start }}{% if ed.start and ed.end %} - {% endif %}{{ ed.end }}{% endif %}{% if ed.gpa %} · {{ t('GPA') }} {{ ed.gpa }}{% endif %}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.recognition %}
  <div>{{ ih(t("Certifications")) }}
    <div style="font-family:Inter,sans-serif; font-size:11.5px; line-height:1.6;">
      {% for rec in r.recognition %}<div>{{ rec.title }}{% if rec.detail %} — {{ rec.detail }}{% endif %}</div>{% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.tools %}
  <div>{{ ih(t("Tools")) }}
    <div style="font-family:Inter,sans-serif; font-size:11.5px; line-height:1.6;">{{ r.tools | join(" · ") }}</div>
  </div>
  {% endif %}

  {% if r.languages %}
  <div>{{ ih(t("Languages")) }}
    <div style="font-family:Inter,sans-serif; font-size:11.5px; line-height:1.6;">{% for l in r.languages %}{{ l.name }} — {{ l.level }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
  </div>
  {% endif %}
</div>
