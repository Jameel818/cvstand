{# ATS Template 10 — Marker · single column · pure white, hairlines only, one highlight swipe
   Ported from block <!-- 10 --> / id="t10" of "ATS Resume Templates Coded.dc.html".
   Locked spec: ink #16161A, hairline #D6D6DA, one chartreuse swipe #D8F035 on a
   summary phrase (r.summary_highlight). Archivo 900 heads (12.5px / 2.4px) +
   Source Sans 3 body. Name Archivo 900 52px; a 1px full-width rule under the
   masthead. Section heads carry a #D6D6DA underline except KEY ACHIEVEMENTS.
   Skills are one row each: name | level (real text) | five dots. ATS-safe:
   single column, the swipe is the only fill.

   Divergences from ref (hairline-only marker reference):
     1. Ink #16161A + chartreuse #D8F035 swipe; hairline #D6D6DA.
     2. Type — Archivo 900 + Source Sans 3.
     3. Contact on one masthead line, pipe-separated.
     4. Ref has Education then Certifications as separate blocks; here Education +
        Certifications share one underlined section and Tools + Languages share
        the next, so the lower-density layout still seats the shared sample.
     5. Section gap 18->15 for the same reason. #}
{% set H = "font-family:Archivo,sans-serif; font-weight:900; font-size:12.5px; letter-spacing:2.4px; padding-bottom:6px; border-bottom:1px solid #D6D6DA; margin-bottom:9px;" %}
{% set H_PLAIN = "font-family:Archivo,sans-serif; font-weight:900; font-size:12.5px; letter-spacing:2.4px; margin-bottom:8px;" %}
<div class="tpl cv-sections-taj" style="box-sizing:border-box; width:850px; height:1100px; background:#ffffff; padding:58px 66px 44px; display:flex; flex-direction:column; gap:15px; font-family:'Source Sans 3',sans-serif; color:#16161A;">

  <div>
    <div class="cv-name" style="font-family:Archivo,sans-serif; font-weight:900; font-size:52px; line-height:0.98; letter-spacing:-1.8px; text-transform:uppercase;">{{ r.name }}</div>
    {% if r.title %}<div style="font-size:14px; font-weight:600; letter-spacing:3.2px; text-transform:uppercase; color:#5C5C66; margin-top:11px;">{{ r.title }}</div>{% endif %}
    {% set c = r.contact %}{% set bits = [] %}
    {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
    {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
    {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
    {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
    {% for s in c.social %}{% if s.label %}{% set _ = bits.append(s.label) %}{% endif %}{% endfor %}
    {% if bits %}<div style="font-size:12px; color:#5C5C66; margin-top:9px; line-height:1.6;">{{ bits | join(" | ") }}</div>{% endif %}
  </div>
  <div style="height:1px; background:#16161A;"></div>

  {% if r.summary %}
  <div>
    <div class="cv-section" style="{{ H }}">{{ t('SUMMARY') }}</div>
    <p style="margin:0; font-size:14px; line-height:1.6; color:#33333B; max-width:600px;">
      {%- if r.summary_highlight and r.summary_highlight in r.summary -%}
        {%- set around = r.summary.split(r.summary_highlight, 1) -%}
        {{ around[0] }}<span style="background:#D8F035; padding:1px 5px;">{{ r.summary_highlight }}</span>{{ around[1] }}
      {%- else -%}
        {{ r.summary }}
      {%- endif -%}
    </p>
  </div>
  {% endif %}

  {% if r.achievements %}
  <div>
    <div class="cv-section" style="{{ H_PLAIN }}">{{ t('KEY ACHIEVEMENTS') }}</div>
    <div style="font-size:12px; line-height:1.75;">
      {% for a in r.achievements %}
      <div><span style="font-family:Archivo,sans-serif; font-weight:900;">{{ a.metric }}</span> — {{ a.label }}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.experience %}
  <div>
    <div class="cv-section" style="{{ H }} margin-bottom:10px;">{{ t('EXPERIENCE') }}</div>
    <div style="display:flex; flex-direction:column; gap:13px;">
      {% for job in r.experience %}
      <div>
        <div style="display:flex; justify-content:space-between; align-items:baseline; gap:14px;">
          <span style="font-family:Archivo,sans-serif; font-weight:800; font-size:14px;">{{ job.role }}</span>
          {% if job.start or job.end %}<span style="font-size:11.5px; color:#63636D; white-space:nowrap;">{{ job.start }}{% if job.start and job.end %} – {% endif %}{{ job.end }}</span>{% endif %}
        </div>
        {% if job.company or job.location %}<div style="font-size:12px; color:#3E3E48; margin:3px 0 5px;">{{ job.company }}{% if job.company and job.location %}, {% endif %}{{ job.location }}</div>{% endif %}
        {% if job.bullets %}
        <ul style="margin:0; padding-inline-start:17px; font-size:12px; line-height:1.6;">
          {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.skills %}
  <div>
    <div class="cv-section" style="{{ H }}">{{ t('SKILLS') }}</div>
    <div style="display:flex; flex-direction:column; gap:6px; font-size:12px;">
      {% for sk in r.skills %}
      <div style="display:flex; align-items:center; gap:12px;">
        <span style="width:200px; flex-shrink:0;">{{ sk.name }}</span>
        <span style="width:82px; flex-shrink:0; font-weight:700;">{{ sk.level }}</span>
        {% if sk.level %}
        <span style="display:flex; gap:4px;">
          {% for i in range(sk.dot_total) %}
          {% if i < sk.dots %}
          <span style="width:8px; height:8px; border-radius:50%; background:#16161A;"></span>
          {% else %}
          <span style="width:8px; height:8px; border-radius:50%; border:1px solid #B8B8BE; box-sizing:border-box;"></span>
          {% endif %}
          {% endfor %}
        </span>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.education or r.recognition %}
  <div>
    <div style="{{ H }} margin-bottom:8px;">{{ t('EDUCATION & CERTIFICATIONS') if r.recognition else t('EDUCATION') }}</div>
    <div style="font-size:12px; line-height:1.7;">
      {% for ed in r.education %}
      <div><b>{{ ed.degree }}</b>{% if ed.school %} — {{ ed.school }}{% endif %}{% if ed.start or ed.end %}, {{ ed.start }}{% if ed.start and ed.end %} – {% endif %}{{ ed.end }}{% endif %}{% if ed.gpa %} &nbsp;·&nbsp; {{ t('GPA') }} {{ ed.gpa }}{% endif %}</div>
      {% for b in ed.bullets %}<div style="color:#5C5C66;">{{ b }}</div>{% endfor %}
      {% endfor %}
      {% for rec in r.recognition %}<div>{{ rec.title }}{% if rec.detail %} — {{ rec.detail }}{% endif %}</div>{% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.tools or r.languages %}
  <div>
    <div style="{{ H }} margin-bottom:8px;">{% set labs = [] %}{% if r.tools %}{% set _ = labs.append(t('TOOLS')) %}{% endif %}{% if r.languages %}{% set _ = labs.append(t('LANGUAGES')) %}{% endif %}{{ join_labels(labs) }}</div>
    <div style="font-size:12px; line-height:1.7;">
      {% if r.tools %}<div>{{ r.tools | join(" · ") }}</div>{% endif %}
      {% if r.languages %}<div>{% for l in r.languages %}{{ l.name }} — {{ l.level }}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
    </div>
  </div>
  {% endif %}
</div>
