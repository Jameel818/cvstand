{# ATS Template 12 — Serif Executive · single column · ink only, generous leading
   Ported from block <!-- 12 --> / id="t12" of "ATS Resume Templates Coded.dc.html".
   Locked spec: ink #1C1F26, tint #4A5568 / #5B6472, no accent colour. Merriweather
   700 for the centred name, the metric numerals and every section label (13px /
   2.4px, no rule); Open Sans body at 1.75 leading. A single 1px full-width rule
   under the name. Skills are "name  Level" rows, level bold — real text, no
   graphic. ATS-safe: one column, no fills.

   Divergences from ref (serif executive reference):
     1. Ink-only palette locked to #1C1F26 + #4A5568.
     2. Type — Merriweather + Open Sans, not one serif family.
     3. Contact on one centred line, pipe-separated.
     4. Ref ends at Education; Certifications (r.recognition), Tools and Languages,
        when present, share one trailing block (dynamic label + one line each) so
        the spacious 1.75-leading layout still seats the shared sample. #}
{% set H = "font-family:Merriweather,serif; font-weight:700; font-size:13px; letter-spacing:2.4px; text-transform:uppercase; margin-bottom:8px;" %}
<div class="tpl" style="box-sizing:border-box; width:850px; height:1100px; background:#ffffff; padding:62px 76px; display:flex; flex-direction:column; gap:20px; font-family:'Open Sans',sans-serif; color:#1C1F26;">

  <div style="text-align:center;">
    <div style="font-family:Merriweather,serif; font-weight:700; font-size:36px; line-height:1.15; letter-spacing:0.4px;">{{ r.name }}</div>
    {% if r.title %}<div style="font-size:12.5px; letter-spacing:4.6px; text-transform:uppercase; color:#4A5568; margin-top:11px;">{{ r.title }}</div>{% endif %}
    <div style="height:1px; background:#1C1F26; margin:14px 0 12px;"></div>
    {% set c = r.contact %}{% set bits = [] %}
    {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
    {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
    {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
    {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
    {% for s in c.social %}{% if s.label %}{% set _ = bits.append(s.label) %}{% endif %}{% endfor %}
    {% if bits %}<div style="font-size:12px; color:#4A5568; line-height:1.6;">{{ bits | join(" | ") }}</div>{% endif %}
  </div>

  {% if r.summary %}
  <div>
    <div style="{{ H }}">{{ t('Summary') }}</div>
    <p style="margin:0; font-size:12.5px; line-height:1.75;">{{ r.summary }}</p>
  </div>
  {% endif %}

  {% if r.achievements %}
  <div>
    <div style="{{ H }}">{{ t('Key Achievements') }}</div>
    <div style="font-size:12.5px; line-height:1.85;">
      {% for a in r.achievements %}
      <div><span style="font-family:Merriweather,serif; font-weight:700;">{{ a.metric }}</span> — {{ a.label }}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.experience %}
  <div>
    <div style="{{ H }} margin-bottom:10px;">{{ t('Experience') }}</div>
    <div style="display:flex; flex-direction:column; gap:14px;">
      {% for job in r.experience %}
      <div>
        <div style="display:flex; justify-content:space-between; align-items:baseline; gap:14px;">
          <span style="font-family:Merriweather,serif; font-weight:700; font-size:13.5px;">{{ job.role }}</span>
          {% if job.start or job.end %}<span style="font-size:11.5px; color:#5B6472; white-space:nowrap;">{{ job.start }}{% if job.start and job.end %} – {% endif %}{{ job.end }}</span>{% endif %}
        </div>
        {% if job.company or job.location %}<div style="font-size:12.5px; color:#4A5568; margin:3px 0 5px;">{{ job.company }}{% if job.company and job.location %}, {% endif %}{{ job.location }}</div>{% endif %}
        {% if job.bullets %}
        <ul style="margin:0; padding-inline-start:18px; font-size:12.5px; line-height:1.65;">
          {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.skills %}
  <div>
    <div style="{{ H }}">{{ t('Skills') }}</div>
    <div style="display:flex; flex-direction:column; gap:5px; font-size:12.5px;">
      {% for sk in r.skills %}
      <div style="display:flex; gap:12px;"><span style="width:235px; flex-shrink:0;">{{ sk.name }}</span><span style="font-weight:700;">{{ sk.level }}</span></div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.education %}
  <div>
    <div style="{{ H }}">{{ t('Education') }}</div>
    <div style="font-size:12.5px; line-height:1.75;">
      {% for ed in r.education %}
      <div><b>{{ ed.degree }}</b>{% if ed.school %} — {{ ed.school }}{% endif %}{% if ed.start or ed.end %}, {{ ed.start }}{% if ed.start and ed.end %} – {% endif %}{{ ed.end }}{% endif %}{% if ed.gpa %} · {{ t('GPA') }} {{ ed.gpa }}{% endif %}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.recognition or r.tools or r.languages %}
  <div>
    <div style="{{ H }}">
      {%- set labs = [] -%}
      {% if r.recognition %}{% set _ = labs.append(t('Certifications')) %}{% endif %}
      {% if r.tools %}{% set _ = labs.append(t('Tools')) %}{% endif %}
      {% if r.languages %}{% set _ = labs.append(t('Languages')) %}{% endif %}
      {{ join_labels(labs) }}
    </div>
    <div style="font-size:12.5px; line-height:1.75;">
      {% if r.recognition %}<div>{% for rec in r.recognition %}{{ rec.title }}{% if rec.detail %} ({{ rec.detail }}){% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
      {% if r.tools %}<div>{{ r.tools | join(" · ") }}</div>{% endif %}
      {% if r.languages %}<div>{% for l in r.languages %}{{ l.name }} — {{ l.level }}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
    </div>
  </div>
  {% endif %}
</div>
