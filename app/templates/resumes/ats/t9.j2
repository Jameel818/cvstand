{# ATS Template 9 — Ledger · single column · double rules, tabular dates, serif masthead
   Ported from block <!-- 9 --> / id="t9" of "ATS Resume Templates Coded.dc.html".
   Locked spec: ink #1A1A1A, brass #7A5C1E, hairline #E0DDD5. Merriweather 700
   serif masthead + section heads (13.5px / 1.4px uppercase); Source Sans 3 body.
   A double rule sits under the masthead (3px over 1px). Dates and metrics use
   tabular-nums. Skills are "name  Level" rows, level in brass — real text, no
   graphic. ATS-safe: single column, one fill-free ledger rhythm.

   Divergences from ref (double-rule ledger reference):
     1. Palette — ink + brass #7A5C1E on white; hairline #E0DDD5.
     2. Type — Merriweather + Source Sans 3, not one serif family.
     3. Contact set on one masthead line, pipe-separated.
     4. Ref's trailing "Education and Certifications" is kept combined and, when
        present, Tools and Languages join it as brass-grey sub-lines rather than
        being dropped. #}
{% set HEAD = "font-family:Merriweather,serif; font-weight:700; font-size:13.5px; letter-spacing:1.4px; text-transform:uppercase; margin-bottom:7px;" %}
{% set HEAD_RULE = "font-family:Merriweather,serif; font-weight:700; font-size:13.5px; letter-spacing:1.4px; text-transform:uppercase; border-bottom:1px solid #1A1A1A; padding-bottom:5px; margin-bottom:10px;" %}
<div class="tpl" style="box-sizing:border-box; width:850px; height:1100px; background:#ffffff; padding:54px 70px; display:flex; flex-direction:column; gap:15px; font-family:'Source Sans 3',sans-serif; color:#1A1A1A;">

  <div>
    <div style="font-family:Merriweather,serif; font-weight:700; font-size:34px; line-height:1.15; letter-spacing:-0.4px;">{{ r.name }}</div>
    {% if r.title %}<div style="font-size:13px; font-weight:600; letter-spacing:2.6px; text-transform:uppercase; color:#7A5C1E; margin-top:8px;">{{ r.title }}</div>{% endif %}
    {% set c = r.contact %}{% set bits = [] %}
    {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
    {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
    {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
    {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
    {% for s in c.social %}{% if s.label %}{% set _ = bits.append(s.label) %}{% endif %}{% endfor %}
    {% if bits %}<div style="font-size:12px; color:#525252; margin-top:8px; line-height:1.6;">{{ bits | join(" | ") }}</div>{% endif %}
  </div>
  <div style="border-top:3px solid #1A1A1A; border-bottom:1px solid #1A1A1A; height:4px;"></div>

  {% if r.summary %}
  <div>
    <div style="{{ HEAD }}">{{ t('Summary') }}</div>
    <p style="margin:0; font-size:12px; line-height:1.6;">{{ r.summary }}</p>
  </div>
  {% endif %}

  {% if r.achievements %}
  <div>
    <div style="{{ HEAD }}">{{ t('Key Achievements') }}</div>
    <div style="font-size:12px; line-height:1.75;">
      {% for a in r.achievements %}
      <div><span style="font-weight:700; color:#7A5C1E; font-variant-numeric:tabular-nums;">{{ a.metric }}</span> — {{ a.label }}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.experience %}
  <div>
    <div style="{{ HEAD_RULE }}">{{ t('Experience') }}</div>
    <div style="display:flex; flex-direction:column; gap:12px;">
      {% for job in r.experience %}
      <div>
        <div style="display:flex; justify-content:space-between; align-items:baseline; gap:14px; border-bottom:1px solid #E0DDD5; padding-bottom:3px;">
          <span style="font-family:Merriweather,serif; font-weight:700; font-size:13px;">{{ job.role }}</span>
          {% if job.start or job.end %}<span style="font-size:11.5px; color:#525252; white-space:nowrap; font-variant-numeric:tabular-nums;">{{ job.start }}{% if job.start and job.end %} – {% endif %}{{ job.end }}</span>{% endif %}
        </div>
        {% if job.company or job.location %}<div style="font-size:12px; color:#7A5C1E; margin:4px 0 4px;">{{ job.company }}{% if job.company and job.location %}, {% endif %}{{ job.location }}</div>{% endif %}
        {% if job.bullets %}
        <ul style="margin:0; padding-inline-start:17px; font-size:12px; line-height:1.55;">
          {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.skills %}
  <div>
    <div style="{{ HEAD_RULE }} margin-bottom:9px;">{{ t('Skills') }}</div>
    <div style="display:flex; flex-direction:column; gap:5px; font-size:12px;">
      {% for sk in r.skills %}
      <div style="display:flex; gap:12px;"><span style="width:230px; flex-shrink:0;">{{ sk.name }}</span><span style="font-weight:700; color:#7A5C1E;">{{ sk.level }}</span></div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.education or r.recognition or r.tools or r.languages %}
  <div>
    <div style="{{ HEAD_RULE }} margin-bottom:8px;">{{ t('Education and Certifications') }}</div>
    <div style="font-size:12px; line-height:1.7;">
      {% for ed in r.education %}
      <div><b>{{ ed.degree }}</b>{% if ed.school %} — {{ ed.school }}{% endif %}{% if ed.start or ed.end %}, {{ ed.start }}{% if ed.start and ed.end %} – {% endif %}{{ ed.end }}{% endif %}{% if ed.gpa %} &nbsp;·&nbsp; {{ t('GPA') }} {{ ed.gpa }}{% endif %}</div>
      {% endfor %}
      {% if r.recognition %}<div style="color:#525252;">{% for rec in r.recognition %}{{ rec.title }}{% if rec.detail %}, {{ rec.detail }}{% endif %}{% if not loop.last %} &nbsp;·&nbsp; {% endif %}{% endfor %}</div>{% endif %}
      {% if r.tools %}<div style="color:#525252;">{{ t('Tools:') }} {{ r.tools | join(" · ") }}</div>{% endif %}
      {% if r.languages %}<div style="color:#525252;">{{ t('Languages:') }} {% for l in r.languages %}{{ l.name }} — {{ l.level }}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
    </div>
  </div>
  {% endif %}
</div>
