{# ATS Template 5 — Sectioned Plum · single column · sectioned editorial, bar levels
   Ported from block <!-- 5 --> / id="t5" of "ATS Resume Templates Coded.dc.html".
   Locked spec: ink #1B1B22, plum #6B2A5A, hairline #D9D7DD on white. Archivo 900
   heads + Inter body. Name set across the full measure (52px), a 2px rule under it
   carrying title (left) + contact (right). Every section opens with a 1px hairline
   and an Archivo 900 / 2.2px plum label above its body. Skills are single-column
   bars, plum fill, level word as real right-aligned text.

   Divergences from ref J (label-margin editorial):
     1. Palette — ink #1B1B22 + plum #6B2A5A on white, not grey-on-grey.
     2. Type — Archivo 900 + Inter, not one geometric sans.
     3. Left 112px label gutter removed for ATS parse-safety: section labels sit
        above their body, not beside it. The per-section hairline is kept so the
        vertical rhythm survives.
     4. Bars carry banded level words as real text; a line-style Key Achievements
        block sits directly under the header.
     5. Ref's trailing "Tooling and Education" is kept as ONE combined hairline
        block (renamed "Education, Tools & Credentials") that also absorbs
        Certifications and Languages as inline sub-labelled rows — so that data
        survives without adding sections the dense shared sample can't fit.
     6. Section gap 28->20, per-section padding-top 13->11, head margin 9->7 to
        seat the shared sample (creative lead, 3 roles, 5 skills) on one page;
        proportions unchanged. #}
{% import "_macros.j2" as m %}
{% set SEC = "border-top:1px solid #D9D7DD; padding-top:11px;" %}
{% set HEAD = "font-family:Archivo,sans-serif; font-weight:900; font-size:12px; letter-spacing:2.2px; text-transform:uppercase; color:#6B2A5A; margin-bottom:7px;" %}
<div class="tpl cv-sections-taj" style="box-sizing:border-box; width:850px; height:1100px; background:#ffffff; padding:50px 58px 40px; font-family:Inter,sans-serif; color:#1B1B22; display:flex; flex-direction:column; gap:20px;">

  <div>
    <div class="cv-name" style="font-family:Archivo,sans-serif; font-weight:900; font-size:52px; line-height:0.98; letter-spacing:-1.8px; text-transform:uppercase;">{{ r.name }}</div>
    {% set c = r.contact %}{% set bits = [] %}
    {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
    {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
    {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
    {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
    {% for s in c.social %}{% if s.label %}{% set _ = bits.append(s.label) %}{% endif %}{% endfor %}
    <div style="display:flex; justify-content:space-between; align-items:baseline; gap:24px; border-top:2px solid #1B1B22; margin-top:14px; padding-top:11px;">
      <span style="font-size:13.5px; font-weight:600; letter-spacing:3.2px; text-transform:uppercase; color:#6B2A5A;">{{ r.title }}</span>
      {% if bits %}<span style="font-size:11.5px; color:#54545E; text-align:end;">{{ bits | join(" · ") }}</span>{% endif %}
    </div>
  </div>

  {% if r.summary %}
  <div style="{{ SEC }}">
    <div class="cv-section" style="{{ HEAD }}">{{ t('Profile') }}</div>
    <p style="margin:0; font-size:12.5px; line-height:1.65;">{{ r.summary }}</p>
  </div>
  {% endif %}

  {% if r.achievements %}
  <div style="{{ SEC }}">
    <div class="cv-section" style="{{ HEAD }}">{{ t('Key Achievements') }}</div>
    <div style="font-size:12px; line-height:1.8;">
      {% for a in r.achievements %}
      <div><span style="font-family:Archivo,sans-serif; font-weight:900; color:#6B2A5A;">{{ a.metric }}</span> — {{ a.label }}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.experience %}
  <div style="{{ SEC }}">
    <div class="cv-section" style="{{ HEAD }}">{{ t('Experience') }}</div>
    <div style="display:flex; flex-direction:column; gap:12px;">
      {% for job in r.experience %}
      <div>
        <div style="display:flex; justify-content:space-between; align-items:baseline; gap:14px;">
          <span style="font-family:Archivo,sans-serif; font-weight:800; font-size:14.5px;">{{ job.role }}</span>
          {% if job.start or job.end %}<span style="font-size:11.5px; color:#63636D; white-space:nowrap;">{{ job.start }}{% if job.start and job.end %} – {% endif %}{{ job.end }}</span>{% endif %}
        </div>
        {% if job.company or job.location %}<div style="font-size:12px; color:#3E3E48; margin:2px 0 4px;">{{ job.company }}{% if job.company and job.location %}, {% endif %}{{ job.location }}</div>{% endif %}
        {% if job.bullets %}
        <ul style="margin:0; padding-inline-start:17px; font-size:12px; line-height:1.55;">
          {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.skills %}
  <div style="{{ SEC }}">
    <div class="cv-section" style="{{ HEAD }}">{{ t('Skills') }}</div>
    <div style="display:flex; flex-direction:column; gap:7px;">
      {% for sk in r.skills %}
      {{ m.skill_bar(sk, {
        'stacked': true,
        'track': '#E4E2E7',
        'fill': '#6B2A5A',
        'track_h': 7,
        'radius': '999px',
        'name_css': 'font-size:12px; color:#1B1B22;',
        'label_css': 'font-size:11px; font-weight:600; color:#5A5A64; text-align:end; flex-shrink:0; padding-inline-start:8px;'
      }) }}
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.education or r.tools or r.recognition or r.languages %}
  {% set SUB = "font-family:Archivo,sans-serif; font-weight:700; color:#6B2A5A; letter-spacing:0.4px;" %}
  <div style="{{ SEC }}">
    <div class="cv-section" style="{{ HEAD }}">{{ t('Education, Tools & Credentials') }}</div>
    <div style="font-size:12px; line-height:1.7; display:flex; flex-direction:column; gap:7px;">
      {% if r.education %}
      <div>
        {% for ed in r.education %}
        <div><b>{{ ed.degree }}</b>{% if ed.school %} — {{ ed.school }}{% endif %}{% if ed.start or ed.end %}, {{ ed.start }}{% if ed.start and ed.end %} – {% endif %}{{ ed.end }}{% endif %}</div>
        {% if ed.gpa %}<div style="color:#54545E;">{{ t('GPA') }} {{ ed.gpa }}</div>{% endif %}
        {% for b in ed.bullets %}<div style="color:#54545E;">{{ b }}</div>{% endfor %}
        {% endfor %}
      </div>
      {% endif %}
      {% if r.tools %}<div style="color:#2E2E38;"><span class="cv-section" style="{{ SUB }}">{{ t('Tools') }}</span> &nbsp;{% for tool in r.tools %}<span style="white-space:nowrap;">{{ tool }}</span>{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
      {% if r.recognition %}<div><span class="cv-section" style="{{ SUB }}">{{ t('Certifications') }}</span> &nbsp;{% for rec in r.recognition %}{{ rec.title }}{% if rec.detail %} ({{ rec.detail }}){% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
      {% if r.languages %}<div><span class="cv-section" style="{{ SUB }}">{{ t('Languages') }}</span> &nbsp;{% for l in r.languages %}{{ l.name }} — {{ l.level }}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
    </div>
  </div>
  {% endif %}
</div>
