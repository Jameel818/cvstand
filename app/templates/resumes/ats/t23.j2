{# ATS Template 23 — Open Air · single column · teal accent, no rules at all, space-only structure
   Ported from block <!-- 23 --> / id="t23" of "ATS Resume Templates Coded.dc.html".
   ATS-safe invariants (16-25): single linear column; canonical single-word
   headings only; label tracking <= 1.2px; skill rows "name — Level" with a real
   em-dash as selectable text; plain-hyphen date ranges. Locked spec: ink
   #13201E, teal #0F6E63, tint #57635F. Poppins throughout — 38px/600 name, no
   display face. Structure carried entirely by whitespace: no rules, no fills,
   no borders anywhere on the canvas.

   Divergences from ref (open-air reference):
     1. Palette locked to ink #13201E + teal #0F6E63 (tint #57635F).
     2. Type — Poppins at every level; the name is weight 600, not a display cut.
     3. Contact on one line, pipe-separated.
     4. Ref ends at Certifications; Tools and Languages, when present, get their
        own canonical single-word sections.
     5. Vertical padding 62->46 and section gap 22->14 to seat the shared sample
        once Tools + Languages are added; the 72px side padding is held so the
        open feel survives the compression. #}
{% macro sh(label) %}
<div class="sec-head" style="font-weight:600; font-size:12px; letter-spacing:1.2px; text-transform:uppercase; color:#0F6E63; margin-bottom:7px;">{{ label }}</div>
{% endmacro %}
<div class="tpl" style="box-sizing:border-box; width:850px; height:1100px; background:#ffffff; padding:46px 72px; display:flex; flex-direction:column; gap:14px; font-family:Poppins,sans-serif; color:#13201E;">

  <div>
    <div style="font-weight:600; font-size:38px; line-height:1.1; letter-spacing:-0.8px;">{{ r.name }}</div>
    {% if r.title %}<div style="font-size:12.5px; font-weight:600; letter-spacing:1.2px; text-transform:uppercase; color:#0F6E63; margin-top:8px;">{{ r.title }}</div>{% endif %}
    {% set c = r.contact %}{% set bits = [] %}
    {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
    {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
    {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
    {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
    {% for s in c.social %}{% if s.label %}{% set _ = bits.append(s.label) %}{% endif %}{% endfor %}
    {% if bits %}<div style="font-size:11.5px; color:#57635F; margin-top:8px; line-height:1.6;">{{ bits | join(" | ") }}</div>{% endif %}
  </div>

  {% if r.summary %}
  <div>{{ sh(t("Summary")) }}
    <p style="margin:0; font-size:12px; line-height:1.6; max-width:640px;">{{ r.summary }}</p>
  </div>
  {% endif %}

  {% if r.achievements %}
  <div>{{ sh(t("Key Achievements")) }}
    <div style="font-size:12px; line-height:1.7;">
      {% for a in r.achievements %}
      <div><span style="font-weight:600; color:#0F6E63;">{{ a.metric }}</span> — {{ a.label }}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.experience %}
  <div>{{ sh(t("Experience")) }}
    <div style="display:flex; flex-direction:column; gap:12px;">
      {% for job in r.experience %}
      <div>
        <div style="display:flex; justify-content:space-between; align-items:baseline; gap:14px;">
          <span style="font-weight:600; font-size:13px;">{{ job.role }}</span>
          {% if job.start or job.end %}<span style="font-size:11px; color:#57635F; white-space:nowrap;">{{ job.start }}{% if job.start and job.end %} - {% endif %}{{ job.end }}</span>{% endif %}
        </div>
        {% if job.company or job.location %}<div style="font-size:11.5px; color:#0F6E63; margin:3px 0 4px;">{{ job.company }}{% if job.company and job.location %}, {% endif %}{{ job.location }}</div>{% endif %}
        {% if job.bullets %}
        <ul style="margin:0; padding-inline-start:17px; font-size:12px; line-height:1.55;">
          {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.skills %}
  <div>{{ sh(t("Skills")) }}
    <div style="display:flex; flex-direction:column; gap:5px; font-size:12px;">
      {% for sk in r.skills %}
      <div style="display:flex;"><span style="width:240px; flex-shrink:0;">{{ sk.name }}</span><span style="font-weight:600; color:#0F6E63;">— {{ sk.level }}</span></div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.education %}
  <div>{{ sh(t("Education")) }}
    <div style="font-size:12px; line-height:1.6;">
      {% for ed in r.education %}
      <div><b>{{ ed.degree }}</b>{% if ed.school %} — {{ ed.school }}{% endif %}{% if ed.start or ed.end %}, {{ ed.start }}{% if ed.start and ed.end %} - {% endif %}{{ ed.end }}{% endif %}{% if ed.gpa %} · {{ t('GPA') }} {{ ed.gpa }}{% endif %}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.recognition %}
  <div>{{ sh(t("Certifications")) }}
    <div style="font-size:12px; line-height:1.6;">
      {% for rec in r.recognition %}<div>{{ rec.title }}{% if rec.detail %} — {{ rec.detail }}{% endif %}</div>{% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.tools %}
  <div>{{ sh(t("Tools")) }}
    <div style="font-size:12px; line-height:1.6;">{{ r.tools | join(" · ") }}</div>
  </div>
  {% endif %}

  {% if r.languages %}
  <div>{{ sh(t("Languages")) }}
    <div style="font-size:12px; line-height:1.6;">{% for l in r.languages %}{{ l.name }} — {{ l.level }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
  </div>
  {% endif %}
</div>
