{# ATS Template 19 — Ochre Ledger · single column · mono dates, warm neutral, ochre accent
   Ported from block <!-- 19 --> / id="t19" of "ATS Resume Templates Coded.dc.html".
   ATS-safe invariants (16-25): single linear column; canonical single-word
   headings only; label tracking <= 1.2px; skill rows "name — Level" with a real
   em-dash as selectable text; plain-hyphen date ranges. Locked spec: ink
   #1C1A15, ochre #B0761A, tint #5D584D. IBM Plex Mono for the section labels,
   the contact block, dates and metric numerals; Source Sans 3 body + the 42px
   name. A single 1px rule under the header; contact set mono and right-aligned.
   No fills.

   Divergences from ref (mono-ledger reference):
     1. Palette locked to ink #1C1A15 + ochre #B0761A.
     2. Type — Source Sans 3 + IBM Plex Mono.
     3. Contact block kept mono / right-aligned, one field per line.
     4. Ref ends at Certifications; Tools and Languages, when present, get their
        own canonical single-word sections.
     5. Section gap 28->14 to seat the shared sample once Tools + Languages are
        added. #}
{% macro mh(label) %}
<div class="sec-head cv-section" style="font-family:'IBM Plex Mono',monospace; font-weight:600; font-size:12px; letter-spacing:1.2px; text-transform:uppercase; color:#B0761A; margin-bottom:7px;">{{ label }}</div>
{% endmacro %}
<div class="tpl" style="box-sizing:border-box; width:850px; height:1100px; background:#ffffff; padding:46px 62px; display:flex; flex-direction:column; gap:14px; font-family:'Source Sans 3',sans-serif; color:#1C1A15;">

  <div style="display:flex; justify-content:space-between; align-items:flex-end; gap:24px; border-bottom:1px solid #1C1A15; padding-bottom:11px;">
    <div>
      <div class="cv-name" style="font-weight:900; font-size:42px; line-height:1.02; letter-spacing:-0.8px;">{{ r.name }}</div>
      {% if r.title %}<div style="font-size:13px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:#B0761A; margin-top:8px;">{{ r.title }}</div>{% endif %}
    </div>
    {% set c = r.contact %}{% set bits = [] %}
    {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
    {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
    {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
    {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
    {% for s in c.social %}{% if s.label %}{% set _ = bits.append(s.label) %}{% endif %}{% endfor %}
    {% if bits %}<div style="font-family:'IBM Plex Mono',monospace; font-size:11px; color:#5D584D; line-height:1.65; text-align:end; white-space:nowrap;">{{ bits | br_join }}</div>{% endif %}
  </div>

  {% if r.summary %}
  <div>{{ mh(t("Summary")) }}
    <p style="margin:0; font-size:12px; line-height:1.55;">{{ r.summary }}</p>
  </div>
  {% endif %}

  {% if r.achievements %}
  <div>{{ mh(t("Key Achievements")) }}
    <div style="font-size:12px; line-height:1.6;">
      {% for a in r.achievements %}
      <div><span style="font-family:'IBM Plex Mono',monospace; font-weight:600; color:#B0761A;">{{ a.metric }}</span> — {{ a.label }}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.experience %}
  <div>{{ mh(t("Experience")) }}
    <div style="display:flex; flex-direction:column; gap:10px;">
      {% for job in r.experience %}
      <div>
        <div style="display:flex; justify-content:space-between; align-items:baseline; gap:14px;">
          <span style="font-weight:800; font-size:13px;">{{ job.role }}</span>
          {% if job.start or job.end %}<span style="font-family:'IBM Plex Mono',monospace; font-size:11px; color:#5D584D; white-space:nowrap;">{{ job.start }}{% if job.start and job.end %} - {% endif %}{{ job.end }}</span>{% endif %}
        </div>
        {% if job.company or job.location %}<div style="font-size:12px; color:#B0761A; margin:2px 0 4px;">{{ job.company }}{% if job.company and job.location %}, {% endif %}{{ job.location }}</div>{% endif %}
        {% if job.bullets %}
        <ul style="margin:0; padding-inline-start:17px; font-size:12px; line-height:1.55;">
          {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.skills %}
  <div>{{ mh(t("Skills")) }}
    <div style="display:flex; flex-direction:column; gap:4px; font-size:12px;">
      {% for sk in r.skills %}
      <div style="display:flex;"><span style="width:230px; flex-shrink:0;">{{ sk.name }}</span><span style="font-weight:700; color:#B0761A;">— {{ sk.level }}</span></div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.education %}
  <div>{{ mh(t("Education")) }}
    <div style="font-size:12px; line-height:1.6;">
      {% for ed in r.education %}
      <div><b>{{ ed.degree }}</b>{% if ed.school %} — {{ ed.school }}{% endif %}{% if ed.start or ed.end %}, {{ ed.start }}{% if ed.start and ed.end %} - {% endif %}{{ ed.end }}{% endif %}{% if ed.gpa %} · {{ t('GPA') }} {{ ed.gpa }}{% endif %}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.recognition %}
  <div>{{ mh(t("Certifications")) }}
    <div style="font-size:12px; line-height:1.6;">
      {% for rec in r.recognition %}<div>{{ rec.title }}{% if rec.detail %} — {{ rec.detail }}{% endif %}</div>{% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.tools %}
  <div>{{ mh(t("Tools")) }}
    <div style="font-size:12px; line-height:1.6;">{{ r.tools | join(" · ") }}</div>
  </div>
  {% endif %}

  {% if r.languages %}
  <div>{{ mh(t("Languages")) }}
    <div style="font-size:12px; line-height:1.6;">{% for l in r.languages %}{{ l.name }} — {{ l.level }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
  </div>
  {% endif %}
</div>
