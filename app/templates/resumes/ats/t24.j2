{# ATS Template 24 — Narrow Two-Tone · single column · olive accent, condensed type, tight rules
   Ported from block <!-- 24 --> / id="t24" of "ATS Resume Templates Coded.dc.html".
   ATS-safe invariants (16-25): single linear column; canonical single-word
   headings only; label tracking <= 1.2px; skill rows "name — Level" with a real
   em-dash as selectable text; plain-hyphen date ranges. Locked spec: ink
   #191A12, olive #5A6B23, tint #575A4C. Archivo Narrow for the 46px name (first
   name light, surname bold), section labels and metric numerals; Inter body. One
   1px rule under the header. No fills.

   Divergences from ref (narrow two-tone reference):
     1. Palette locked to ink #191A12 + olive #5A6B23.
     2. Type — Archivo Narrow headline + Inter body.
     3. Contact on one line, pipe-separated.
     4. Ref ends at Certifications; Tools and Languages, when present, get their
        own canonical single-word sections.
     5. Section gap 25->14, Key Achievements leading 1.78->1.6 to seat the shared
        sample once Tools + Languages are added. #}
{% macro sh(label) %}
<div class="cv-section" style="font-weight:700; font-size:14px; letter-spacing:1.2px; text-transform:uppercase; color:#5A6B23; margin-bottom:6px;">{{ label }}</div>
{% endmacro %}
<div class="tpl cv-sections-taj" style="box-sizing:border-box; width:850px; height:1100px; background:#ffffff; padding:46px 58px; display:flex; flex-direction:column; gap:14px; font-family:'Archivo Narrow',sans-serif; color:#191A12;">

  <div style="border-bottom:1px solid #191A12; padding-bottom:11px;">
    {% set nm = r.name.split(" ", 1) %}
    <div style="font-size:46px; line-height:1.02; letter-spacing:-0.4px;"><span class="cv-name" style="font-weight:400;">{{ nm[0] }}{% if nm|length > 1 %} {% endif %}</span>{% if nm|length > 1 %}<span style="font-weight:700;">{{ nm[1] }}</span>{% endif %}</div>
    {% if r.title %}<div style="font-size:13px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:#5A6B23; margin-top:8px;">{{ r.title }}</div>{% endif %}
    {% set c = r.contact %}{% set bits = [] %}
    {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
    {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
    {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
    {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
    {% for s in c.social %}{% if s.label %}{% set _ = bits.append(s.label) %}{% endif %}{% endfor %}
    {% if bits %}<div style="font-family:Inter,sans-serif; font-size:11.5px; color:#575A4C; margin-top:8px; line-height:1.6;">{{ bits | join(" | ") }}</div>{% endif %}
  </div>

  {% if r.summary %}
  <div>{{ sh(t("Summary")) }}
    <p style="margin:0; font-family:Inter,sans-serif; font-size:12px; line-height:1.55;">{{ r.summary }}</p>
  </div>
  {% endif %}

  {% if r.achievements %}
  <div>{{ sh(t("Key Achievements")) }}
    <div style="font-family:Inter,sans-serif; font-size:12px; line-height:1.6;">
      {% for a in r.achievements %}
      <div><span style="font-family:'Archivo Narrow',sans-serif; font-weight:700; color:#5A6B23;">{{ a.metric }}</span> — {{ a.label }}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.experience %}
  <div>{{ sh(t("Experience")) }}
    <div style="display:flex; flex-direction:column; gap:10px;">
      {% for job in r.experience %}
      <div>
        <div style="display:flex; justify-content:space-between; align-items:baseline; gap:14px;">
          <span style="font-weight:700; font-size:14px;">{{ job.role }}</span>
          {% if job.start or job.end %}<span style="font-family:Inter,sans-serif; font-size:11px; color:#575A4C; white-space:nowrap;">{{ job.start }}{% if job.start and job.end %} - {% endif %}{{ job.end }}</span>{% endif %}
        </div>
        {% if job.company or job.location %}<div style="font-family:Inter,sans-serif; font-size:11.5px; color:#5A6B23; margin:2px 0 4px;">{{ job.company }}{% if job.company and job.location %}, {% endif %}{{ job.location }}</div>{% endif %}
        {% if job.bullets %}
        <ul style="margin:0; padding-inline-start:17px; font-family:Inter,sans-serif; font-size:12px; line-height:1.55;">
          {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.skills %}
  <div>{{ sh(t("Skills")) }}
    <div style="display:flex; flex-direction:column; gap:4px; font-family:Inter,sans-serif; font-size:12px;">
      {% for sk in r.skills %}
      <div style="display:flex;"><span style="width:230px; flex-shrink:0;">{{ sk.name }}</span><span style="font-weight:700; color:#5A6B23;">— {{ sk.level }}</span></div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.education %}
  <div>{{ sh(t("Education")) }}
    <div style="font-family:Inter,sans-serif; font-size:12px; line-height:1.6;">
      {% for ed in r.education %}
      <div><b>{{ ed.degree }}</b>{% if ed.school %} — {{ ed.school }}{% endif %}{% if ed.start or ed.end %}, {{ ed.start }}{% if ed.start and ed.end %} - {% endif %}{{ ed.end }}{% endif %}{% if ed.gpa %} · {{ t('GPA') }} {{ ed.gpa }}{% endif %}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.recognition %}
  <div>{{ sh(t("Certifications")) }}
    <div style="font-family:Inter,sans-serif; font-size:12px; line-height:1.6;">
      {% for rec in r.recognition %}<div>{{ rec.title }}{% if rec.detail %} — {{ rec.detail }}{% endif %}</div>{% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.tools %}
  <div>{{ sh(t("Tools")) }}
    <div style="font-family:Inter,sans-serif; font-size:12px; line-height:1.6;">{{ r.tools | join(" · ") }}</div>
  </div>
  {% endif %}

  {% if r.languages %}
  <div>{{ sh(t("Languages")) }}
    <div style="font-family:Inter,sans-serif; font-size:12px; line-height:1.6;">{% for l in r.languages %}{{ l.name }} — {{ l.level }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
  </div>
  {% endif %}
</div>
