{# ATS Template 22 — Accent Bar · single column · one full-bleed crimson band, Archivo black masthead
   Ported from block <!-- 22 --> / id="t22" of "ATS Resume Templates Coded.dc.html".
   ATS-safe invariants (16-25): single linear column; canonical single-word
   headings only; label tracking <= 1.2px; skill rows "name — Level" with a real
   em-dash as selectable text; plain-hyphen date ranges. Locked spec: ink
   #171215, crimson #9B1B30, tint #5A5054. Archivo throughout — 900 for the 48px
   name, 900 for the section labels. One full-bleed crimson band under the name
   carries the role (left) and contact (right); it is the only fill.

   Divergences from ref (crimson-band reference):
     1. Palette locked to ink #171215 + crimson #9B1B30.
     2. Type — one Archivo family.
     3. Contact rides the crimson band, pipe-separated (wrap allowed).
     4. Ref ends at Certifications; Tools and Languages, when present, get their
        own canonical single-word sections.
     5. Section gap 30->15, Key Achievements leading 2.05->1.6 to seat the shared
        sample once Tools + Languages are added. #}
{% macro sh(label) %}
<div class="cv-section" style="font-weight:900; font-size:13px; letter-spacing:1.2px; text-transform:uppercase; color:#9B1B30; margin-bottom:6px;">{{ label }}</div>
{% endmacro %}
<div class="tpl cv-sections-taj" style="box-sizing:border-box; width:850px; height:1100px; background:#ffffff; padding:0 0 44px; display:flex; flex-direction:column; gap:15px; font-family:Archivo,sans-serif; color:#171215;">

  <div style="padding:44px 60px 0;">
    <div class="cv-name" style="font-weight:900; font-size:48px; line-height:1; letter-spacing:-1.6px; text-transform:uppercase;">{{ r.name }}</div>
  </div>
  <div style="background:#9B1B30; color:#ffffff; padding:11px 60px; margin-top:-4px;">
    <div style="display:flex; justify-content:space-between; align-items:baseline; gap:20px;">
      <span style="font-weight:700; font-size:13px; letter-spacing:1.2px; text-transform:uppercase;">{{ r.title }}</span>
      {% set c = r.contact %}{% set bits = [] %}
      {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
      {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
      {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
      {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
      {% for s in c.social %}{% if s.label %}{% set _ = bits.append(s.label) %}{% endif %}{% endfor %}
      {% if bits %}<span style="font-size:11.5px; text-align:end;">{{ bits | join(" | ") }}</span>{% endif %}
    </div>
  </div>

  {% if r.summary %}
  <div style="padding:0 60px;">{{ sh(t("Summary")) }}
    <p style="margin:0; font-size:12px; line-height:1.55;">{{ r.summary }}</p>
  </div>
  {% endif %}

  {% if r.achievements %}
  <div style="padding:0 60px;">{{ sh(t("Key Achievements")) }}
    <div style="font-size:12px; line-height:1.6;">
      {% for a in r.achievements %}
      <div><span style="font-weight:900; color:#9B1B30;">{{ a.metric }}</span> — {{ a.label }}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.experience %}
  <div style="padding:0 60px;">{{ sh(t("Experience")) }}
    <div style="display:flex; flex-direction:column; gap:12px;">
      {% for job in r.experience %}
      <div>
        <div style="display:flex; justify-content:space-between; align-items:baseline; gap:14px;">
          <span style="font-weight:800; font-size:13px;">{{ job.role }}</span>
          {% if job.start or job.end %}<span style="font-size:11.5px; color:#5A5054; white-space:nowrap;">{{ job.start }}{% if job.start and job.end %} - {% endif %}{{ job.end }}</span>{% endif %}
        </div>
        {% if job.company or job.location %}<div style="font-size:12px; color:#9B1B30; margin:2px 0 4px;">{{ job.company }}{% if job.company and job.location %}, {% endif %}{{ job.location }}</div>{% endif %}
        {% if job.bullets %}
        <ul style="margin:0; padding-inline-start:17px; font-size:12px; line-height:1.55;">
          {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.skills %}
  <div style="padding:0 60px;">{{ sh(t("Skills")) }}
    <div style="display:flex; flex-direction:column; gap:4px; font-size:12px;">
      {% for sk in r.skills %}
      <div style="display:flex;"><span style="width:230px; flex-shrink:0;">{{ sk.name }}</span><span style="font-weight:800; color:#9B1B30;">— {{ sk.level }}</span></div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.education %}
  <div style="padding:0 60px;">{{ sh(t("Education")) }}
    <div style="font-size:12px; line-height:1.6;">
      {% for ed in r.education %}
      <div><b>{{ ed.degree }}</b>{% if ed.school %} — {{ ed.school }}{% endif %}{% if ed.start or ed.end %}, {{ ed.start }}{% if ed.start and ed.end %} - {% endif %}{{ ed.end }}{% endif %}{% if ed.gpa %} · {{ t('GPA') }} {{ ed.gpa }}{% endif %}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.recognition %}
  <div style="padding:0 60px;">{{ sh(t("Certifications")) }}
    <div style="font-size:12px; line-height:1.6;">
      {% for rec in r.recognition %}<div>{{ rec.title }}{% if rec.detail %} — {{ rec.detail }}{% endif %}</div>{% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.tools %}
  <div style="padding:0 60px;">{{ sh(t("Tools")) }}
    <div style="font-size:12px; line-height:1.6;">{{ r.tools | join(" · ") }}</div>
  </div>
  {% endif %}

  {% if r.languages %}
  <div style="padding:0 60px;">{{ sh(t("Languages")) }}
    <div style="font-size:12px; line-height:1.6;">{% for l in r.languages %}{{ l.name }} — {{ l.level }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
  </div>
  {% endif %}
</div>
