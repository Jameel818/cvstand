{# ATS Template 17 — Wide Caps · single column · Anton masthead, forest accent, hairline-only
   Ported from block <!-- 17 --> / id="t17" of "ATS Resume Templates Coded.dc.html".
   ATS-safe invariants (16-25): single linear column; canonical single-word
   headings only; label tracking <= 1.2px; skill rows "name — Level" with a real
   em-dash as selectable text; plain-hyphen date ranges. Locked spec: ink
   #141A17, forest #1F4436, hairline #D2D8D3, tint #4E574F. Anton for the 52px
   name and the 15px section labels; Inter body. A 3px forest rule under the
   header; a 1px hairline under each experience role row. No fills.

   Divergences from ref (Anton masthead reference):
     1. Palette locked to ink #141A17 + forest #1F4436.
     2. Type — Anton + Inter.
     3. Contact on one line, pipe-separated.
     4. Ref ends at Certifications; Tools and Languages, when present, get their
        own canonical single-word sections.
     5. Section gap 17->13 to seat the shared sample once Tools + Languages are
        added. #}
{% macro ah(label) %}
<div style="font-family:Anton,sans-serif; font-size:15px; letter-spacing:1.2px; text-transform:uppercase; color:#1F4436; margin-bottom:7px;">{{ label }}</div>
{% endmacro %}
<div class="tpl" style="box-sizing:border-box; width:850px; height:1100px; background:#ffffff; padding:44px 62px; display:flex; flex-direction:column; gap:12px; font-family:Inter,sans-serif; color:#141A17;">

  <div style="border-bottom:3px solid #1F4436; padding-bottom:12px;">
    <div style="font-family:Anton,sans-serif; font-size:52px; line-height:0.98; letter-spacing:0.5px; text-transform:uppercase;">{{ r.name }}</div>
    {% if r.title %}<div style="font-size:13px; font-weight:600; letter-spacing:1.2px; text-transform:uppercase; color:#1F4436; margin-top:10px;">{{ r.title }}</div>{% endif %}
    {% set c = r.contact %}{% set bits = [] %}
    {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
    {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
    {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
    {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
    {% for s in c.social %}{% if s.label %}{% set _ = bits.append(s.label) %}{% endif %}{% endfor %}
    {% if bits %}<div style="font-size:12px; color:#4E574F; margin-top:8px; line-height:1.6;">{{ bits | join(" | ") }}</div>{% endif %}
  </div>

  {% if r.summary %}
  <div>{{ ah(t("Summary")) }}
    <p style="margin:0; font-size:12px; line-height:1.55;">{{ r.summary }}</p>
  </div>
  {% endif %}

  {% if r.achievements %}
  <div>{{ ah(t("Key Achievements")) }}
    <div style="font-size:12px; line-height:1.6;">
      {% for a in r.achievements %}
      <div><span style="font-family:Anton,sans-serif; color:#1F4436;">{{ a.metric }}</span> — {{ a.label }}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.experience %}
  <div>{{ ah(t("Experience")) }}
    <div style="display:flex; flex-direction:column; gap:11px;">
      {% for job in r.experience %}
      <div>
        <div style="display:flex; justify-content:space-between; align-items:baseline; gap:14px; border-bottom:1px solid #D2D8D3; padding-bottom:3px;">
          <span style="font-weight:700; font-size:13px;">{{ job.role }}</span>
          {% if job.start or job.end %}<span style="font-size:11.5px; color:#4E574F; white-space:nowrap;">{{ job.start }}{% if job.start and job.end %} - {% endif %}{{ job.end }}</span>{% endif %}
        </div>
        {% if job.company or job.location %}<div style="font-size:12px; color:#1F4436; margin:3px 0 4px;">{{ job.company }}{% if job.company and job.location %}, {% endif %}{{ job.location }}</div>{% endif %}
        {% if job.bullets %}
        <ul style="margin:0; padding-inline-start:17px; font-size:12px; line-height:1.55;">
          {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.skills %}
  <div>{{ ah(t("Skills")) }}
    <div style="display:flex; flex-direction:column; gap:4px; font-size:12px;">
      {% for sk in r.skills %}
      <div style="display:flex;"><span style="width:230px; flex-shrink:0;">{{ sk.name }}</span><span style="font-weight:700; color:#1F4436;">— {{ sk.level }}</span></div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.education %}
  <div>{{ ah(t("Education")) }}
    <div style="font-size:12px; line-height:1.6;">
      {% for ed in r.education %}
      <div><b>{{ ed.degree }}</b>{% if ed.school %} — {{ ed.school }}{% endif %}{% if ed.start or ed.end %}, {{ ed.start }}{% if ed.start and ed.end %} - {% endif %}{{ ed.end }}{% endif %}{% if ed.gpa %} · {{ t('GPA') }} {{ ed.gpa }}{% endif %}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.recognition %}
  <div>{{ ah(t("Certifications")) }}
    <div style="font-size:12px; line-height:1.6;">
      {% for rec in r.recognition %}<div>{{ rec.title }}{% if rec.detail %} — {{ rec.detail }}{% endif %}</div>{% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.tools %}
  <div>{{ ah(t("Tools")) }}
    <div style="font-size:12px; line-height:1.6;">{{ r.tools | join(" · ") }}</div>
  </div>
  {% endif %}

  {% if r.languages %}
  <div>{{ ah(t("Languages")) }}
    <div style="font-size:12px; line-height:1.6;">{% for l in r.languages %}{{ l.name }} — {{ l.level }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
  </div>
  {% endif %}
</div>
