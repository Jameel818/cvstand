{# ATS Template 18 — Indent Rule · single column · indigo accent, left border on every section
   Ported from block <!-- 18 --> / id="t18" of "ATS Resume Templates Coded.dc.html".
   ATS-safe invariants (16-25): single linear column; canonical single-word
   headings only; label tracking <= 1.2px; skill rows "name — Level" with a real
   em-dash as selectable text; plain-hyphen date ranges. Locked spec: ink
   #16182B, indigo #35408E, pale rule #DADCEC, tint #525573. Montserrat
   throughout (800 for the 40px name and the section labels). Header carries a
   4px indigo left border; every other section a 4px #DADCEC left border with
   16px indent. No fills.

   Divergences from ref (left-border indent reference):
     1. Palette locked to ink #16182B + indigo #35408E.
     2. Type — Montserrat only.
     3. Contact on one line, pipe-separated.
     4. Ref ends at Certifications; Tools and Languages, when present, get their
        own canonical single-word sections.
     5. Section gap 28->14, Key Achievements leading 2.0->1.6, skills gap 9->4 to
        seat the shared sample once Tools + Languages are added. #}
{% macro sh(label) %}
<div style="font-weight:800; font-size:12.5px; letter-spacing:1.2px; text-transform:uppercase; color:#35408E; margin-bottom:7px;">{{ label }}</div>
{% endmacro %}
{% set SEC = "border-inline-start:4px solid #DADCEC; padding-inline-start:16px;" %}
<div class="tpl" style="box-sizing:border-box; width:850px; height:1100px; background:#ffffff; padding:46px 60px; display:flex; flex-direction:column; gap:14px; font-family:Montserrat,sans-serif; color:#16182B;">

  <div style="border-inline-start:4px solid #35408E; padding-inline-start:16px;">
    <div style="font-weight:800; font-size:40px; line-height:1.06; letter-spacing:-0.8px;">{{ r.name }}</div>
    {% if r.title %}<div style="font-size:12.5px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:#35408E; margin-top:8px;">{{ r.title }}</div>{% endif %}
    {% set c = r.contact %}{% set bits = [] %}
    {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
    {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
    {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
    {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
    {% for s in c.social %}{% if s.label %}{% set _ = bits.append(s.label) %}{% endif %}{% endfor %}
    {% if bits %}<div style="font-size:12px; color:#525573; margin-top:8px; line-height:1.6;">{{ bits | join(" | ") }}</div>{% endif %}
  </div>

  {% if r.summary %}
  <div style="{{ SEC }}">{{ sh(t("Summary")) }}
    <p style="margin:0; font-size:12px; line-height:1.55;">{{ r.summary }}</p>
  </div>
  {% endif %}

  {% if r.achievements %}
  <div style="{{ SEC }}">{{ sh(t("Key Achievements")) }}
    <div style="font-size:12px; line-height:1.6;">
      {% for a in r.achievements %}
      <div><span style="font-weight:800; color:#35408E;">{{ a.metric }}</span> — {{ a.label }}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.experience %}
  <div style="{{ SEC }}">{{ sh(t("Experience")) }}
    <div style="display:flex; flex-direction:column; gap:10px;">
      {% for job in r.experience %}
      <div>
        <div style="display:flex; justify-content:space-between; align-items:baseline; gap:14px;">
          <span style="font-weight:700; font-size:13px;">{{ job.role }}</span>
          {% if job.start or job.end %}<span style="font-size:11.5px; color:#525573; white-space:nowrap;">{{ job.start }}{% if job.start and job.end %} - {% endif %}{{ job.end }}</span>{% endif %}
        </div>
        {% if job.company or job.location %}<div style="font-size:12px; color:#35408E; margin:2px 0 4px;">{{ job.company }}{% if job.company and job.location %}, {% endif %}{{ job.location }}</div>{% endif %}
        {% if job.bullets %}
        <ul style="margin:0; padding-inline-start:17px; font-size:12px; line-height:1.55;">
          {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.skills %}
  <div style="{{ SEC }}">{{ sh(t("Skills")) }}
    <div style="display:flex; flex-direction:column; gap:4px; font-size:12px;">
      {% for sk in r.skills %}
      <div style="display:flex;"><span style="width:230px; flex-shrink:0;">{{ sk.name }}</span><span style="font-weight:700; color:#35408E;">— {{ sk.level }}</span></div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.education %}
  <div style="{{ SEC }}">{{ sh(t("Education")) }}
    <div style="font-size:12px; line-height:1.6;">
      {% for ed in r.education %}
      <div><b>{{ ed.degree }}</b>{% if ed.school %} — {{ ed.school }}{% endif %}{% if ed.start or ed.end %}, {{ ed.start }}{% if ed.start and ed.end %} - {% endif %}{{ ed.end }}{% endif %}{% if ed.gpa %} · {{ t('GPA') }} {{ ed.gpa }}{% endif %}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.recognition %}
  <div style="{{ SEC }}">{{ sh(t("Certifications")) }}
    <div style="font-size:12px; line-height:1.6;">
      {% for rec in r.recognition %}<div>{{ rec.title }}{% if rec.detail %} — {{ rec.detail }}{% endif %}</div>{% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.tools %}
  <div style="{{ SEC }}">{{ sh(t("Tools")) }}
    <div style="font-size:12px; line-height:1.6;">{{ r.tools | join(" · ") }}</div>
  </div>
  {% endif %}

  {% if r.languages %}
  <div style="{{ SEC }}">{{ sh(t("Languages")) }}
    <div style="font-size:12px; line-height:1.6;">{% for l in r.languages %}{{ l.name }} — {{ l.level }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
  </div>
  {% endif %}
</div>
