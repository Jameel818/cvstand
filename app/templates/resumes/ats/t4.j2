{# ATS Template 4 — Editorial Redline · single column · pure white, hairlines, redline marker
   Ported from block <!-- 4 --> / id="t4" of "ATS Resume Templates Coded.dc.html".
   ATS-safe port of Modern t1. Locked spec: ink #16161A, chartreuse marker
   #D8F035, hairline #D6D6DA. Archivo 900 heads (13px / 2.2px) + Source Sans 3
   body. Oversized name over a 1px #16161A rule; a four-line quantified band;
   skills as "name  Level  ●●●●●" dot-grid rows (name AND level as real text).
   Single reading-order column — contact sits inline, not in a rail; the marker
   swipe is the one fill, a background behind real text.

   Divergences from ref F (pure-white editorial, redline marker):
     1. Palette — ink #16161A + chartreuse #D8F035, not black/orange.
     2. Type — Archivo 900 + Source Sans 3, not one neo-grotesque.
     3. Flat skill list becomes dot-grid rows carrying name and level as real
        text; a four-line quantified band sits under a rule.
     4. Recognition + Education + Languages share one trailing block (as in the
        reference); Tools keep their own section. #}
{% set H = "font-family:Archivo,sans-serif; font-weight:900; font-size:13px; letter-spacing:2.2px; text-transform:uppercase; padding-bottom:6px; border-bottom:1px solid #D6D6DA; margin-bottom:9px;" %}
<div class="tpl" style="box-sizing:border-box; width:850px; height:1100px; background:#ffffff; padding:50px 60px 44px; font-family:'Source Sans 3',sans-serif; color:#16161A; display:flex; flex-direction:column; gap:15px;">

  <div style="border-bottom:1px solid #16161A; padding-bottom:14px;">
    <div style="font-family:Archivo,sans-serif; font-weight:900; font-size:52px; line-height:0.96; letter-spacing:-1.8px; text-transform:uppercase;">{{ r.name }}</div>
    {% if r.title %}<div style="font-size:14px; font-weight:600; letter-spacing:3px; text-transform:uppercase; color:#5C5C66; margin-top:10px;">{{ r.title }}</div>{% endif %}
    {% set c = r.contact %}{% set bits = [] %}
    {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
    {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
    {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
    {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
    {% for s in c.social %}{% if s.label %}{% set _ = bits.append(s.label) %}{% endif %}{% endfor %}
    {% if bits %}<div style="font-size:12px; color:#5C5C66; margin-top:9px; line-height:1.6;">{{ bits | join(" | ") }}</div>{% endif %}
  </div>

  {% if r.summary %}
  <div>
    <div style="{{ H }}">{{ t('Summary') }}</div>
    <p style="margin:0; font-size:12.5px; line-height:1.65;">
      {%- if r.summary_highlight and r.summary_highlight in r.summary -%}
        {%- set around = r.summary.split(r.summary_highlight, 1) -%}
        {{ around[0] }}<span style="background:#D8F035; padding:1px 5px;">{{ r.summary_highlight }}</span>{{ around[1] }}
      {%- else -%}
        {{ r.summary }}
      {%- endif -%}
    </p>
  </div>
  {% endif %}

  {% if r.achievements %}
  <div>
    <div style="{{ H }}">{{ t('Key Achievements') }}</div>
    <div style="font-size:12px; line-height:1.8;">
      {% for a in r.achievements %}
      <div><span style="font-family:Archivo,sans-serif; font-weight:900;">{{ a.metric }}</span> — {{ a.label }}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.experience %}
  <div>
    <div style="{{ H }}">{{ t('Experience') }}</div>
    <div style="display:flex; flex-direction:column; gap:12px;">
      {% for job in r.experience %}
      <div>
        <div style="display:flex; justify-content:space-between; align-items:baseline; gap:14px;">
          <span style="font-family:Archivo,sans-serif; font-weight:800; font-size:14px;">{{ job.role }}</span>
          {% if job.start or job.end %}<span style="font-size:11.5px; color:#6A6A74; white-space:nowrap;">{{ job.start }}{% if job.start and job.end %} – {% endif %}{{ job.end }}</span>{% endif %}
        </div>
        {% if job.company or job.location %}<div style="font-size:12px; color:#3A3A42; margin:2px 0 4px;">{{ job.company }}{% if job.company and job.location %}, {% endif %}{{ job.location }}</div>{% endif %}
        {% if job.bullets %}
        <ul style="margin:0; padding-inline-start:17px; font-size:12px; line-height:1.55;">
          {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.skills %}
  <div>
    <div style="{{ H }}">{{ t('Capabilities') }}</div>
    <div style="display:flex; flex-direction:column; gap:5px; font-size:12px;">
      {% for sk in r.skills %}
      <div style="display:flex; align-items:center; gap:14px;">
        <span style="width:215px; flex-shrink:0;">{{ sk.name }}</span>
        <span style="width:80px; flex-shrink:0; font-weight:600; color:#5C5C66;">{{ sk.level }}</span>
        {% if sk.level %}
        <span style="display:flex; gap:5px;">
          {% for i in range(sk.dot_total) %}
          {% if i < sk.dots %}
          <span style="width:9px; height:9px; border-radius:50%; background:#16161A;"></span>
          {% else %}
          <span style="width:9px; height:9px; border-radius:50%; border:1px solid #B8B8BE; box-sizing:border-box;"></span>
          {% endif %}
          {% endfor %}
        </span>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.tools %}
  <div>
    <div style="{{ H }}">{{ t('Tools') }}</div>
    <p style="margin:0; font-size:12px; line-height:1.7; color:#3A3A42;">{% for tool in r.tools %}<span style="white-space:nowrap;">{{ tool }}</span>{% if not loop.last %} · {% endif %}{% endfor %}</p>
  </div>
  {% endif %}

  {% if r.recognition or r.education or r.languages %}
  <div>
    <div style="{{ H }}">
      {%- set labs = [] -%}
      {% if r.recognition %}{% set _ = labs.append(t('Recognition')) %}{% endif %}
      {% if r.education %}{% set _ = labs.append(t('Education')) %}{% endif %}
      {% if r.languages %}{% set _ = labs.append(t('Languages')) %}{% endif %}
      {{ join_labels(labs, 'and') }}
    </div>
    <div style="font-size:12px; line-height:1.7;">
      {% for rec in r.recognition %}<div><b>{{ rec.title }}</b>{% if rec.detail %} — {{ rec.detail }}{% endif %}</div>{% endfor %}
      {% for ed in r.education %}<div><b>{{ ed.degree }}</b>{% if ed.school %} — {{ ed.school }}{% endif %}{% if ed.start or ed.end %}, {{ ed.start }}{% if ed.start and ed.end %} – {% endif %}{{ ed.end }}{% endif %}{% if ed.gpa %} · {{ t('GPA') }} {{ ed.gpa }}{% endif %}</div>{% endfor %}
      {% if r.languages %}<div style="color:#5C5C66;">{% for l in r.languages %}{{ l.name }} — {{ l.level }}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
    </div>
  </div>
  {% endif %}
</div>
