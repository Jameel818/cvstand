{# ATS Template 3 — Portal Standard · single column · dot-grid levels
   Ported from block <!-- 3 --> / id="t3" of "ATS Resume Templates Coded.dc.html".
   ATS-safe: no sidebar, no colour blocks, no reversed-out type, no icons, no
   multi-column bands. Single linear flow so a parser reads it in source order.
   Locked spec: ink #111111, hairline #cccccc, Archivo, dot-grid skill levels,
   achievements as plain "metric — caption" text lines (not chips).
   NOTE: the "Certifications" block is fed from `recognition` (title — detail);
   the shared data model has no separate certifications list. #}
{% import "_macros.j2" as m %}
{% set HEAD = "font-weight:700; font-size:14px; letter-spacing:1px; color:#111111; margin:0 0 8px;" %}
{% macro rule() %}<div style="height:1px; background:#cccccc;"></div>{% endmacro %}
<div class="tpl" style="box-sizing:border-box; width:850px; height:1100px; background:#ffffff; padding:56px 72px; display:flex; flex-direction:column; gap:17px; font-family:Archivo,sans-serif; color:#111111;">

  <div>
    <div style="font-weight:900; font-size:30px; line-height:1.1; color:#111111; text-transform:uppercase;">{{ r.name }}</div>
    {% if r.title %}<div style="font-size:14px; color:#111111; margin-top:4px;">{{ r.title }}</div>{% endif %}
    {% set c = r.contact %}
    {% set bits = [] %}
    {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
    {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
    {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
    {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
    {% for s in c.social %}{% set _ = bits.append(s.url or s.label) %}{% endfor %}
    {% if bits %}<div style="font-size:12px; color:#555555; margin-top:6px; line-height:1.6;">{{ bits | join(" | ") }}</div>{% endif %}
  </div>

  {{ rule() }}

  {% if r.summary %}
  <div>
    <div style="{{ HEAD }}">{{ t('SUMMARY') }}</div>
    <p style="font-size:12px; color:#111111; line-height:1.55; margin:0;">{{ r.summary }}</p>
  </div>
  {% endif %}

  {% if r.achievements %}
  <div>
    <div style="{{ HEAD }}">{{ t('KEY ACHIEVEMENTS') }}</div>
    <div style="font-size:12px; color:#111111; line-height:1.7;">
      {% for a in r.achievements %}<div>{{ a.metric }} — {{ a.label }}</div>{% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.experience %}
  <div>
    <div style="{{ HEAD }}">{{ t('PROFESSIONAL EXPERIENCE') }}</div>
    <div style="display:flex; flex-direction:column; gap:11px;">
      {% for job in r.experience %}
      <div>
        <div style="font-size:12.5px; color:#111111;"><b>{{ job.role }}</b></div>
        {% if job.company or job.location %}
        <div style="font-size:12px; color:#111111;">{{ job.company }}{% if job.company and job.location %}, {% endif %}{{ job.location }}</div>
        {% endif %}
        {% if job.start or job.end %}
        <div style="font-size:12px; color:#555555;">{{ job.start }}{% if job.start and job.end %} – {% endif %}{{ job.end }}</div>
        {% endif %}
        {% if job.bullets %}
        <ul style="margin:4px 0 0; padding-inline-start:18px; font-size:12px; color:#111111; line-height:1.5;">
          {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.skills %}
  <div>
    <div style="{{ HEAD }}">{{ t('SKILLS') }}</div>
    <div style="display:flex; flex-direction:column; gap:6px;">
      {% for sk in r.skills %}
      <div style="display:flex; align-items:center; gap:10px;">
        <span style="font-size:12px; color:#111111; width:210px; flex-shrink:0;">{{ sk.name }}</span>
        <span style="font-size:12px; color:#111111; font-weight:700; width:96px; flex-shrink:0;">{{ sk.level }}</span>
        {% if sk.level %}
        <span style="display:flex; gap:4px;">
          {% for i in range(sk.dot_total) %}
          {% if i < sk.dots %}
          <span style="width:9px; height:9px; border-radius:50%; background:#111111;"></span>
          {% else %}
          <span style="width:9px; height:9px; border-radius:50%; border:1px solid #555555; box-sizing:border-box;"></span>
          {% endif %}
          {% endfor %}
        </span>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.tools %}
  <div>
    <div style="{{ HEAD }}">{{ t('TOOLS') }}</div>
    <div style="font-size:12px; color:#111111; line-height:1.7;">{{ r.tools | join(" · ") }}</div>
  </div>
  {% endif %}

  {% if r.education %}
  <div>
    <div style="{{ HEAD }}">{{ t('EDUCATION') }}</div>
    <div style="font-size:12px; color:#111111; line-height:1.6;">
      {% for ed in r.education %}
      <div><b>{{ ed.degree }}</b>{% if ed.school %} — {{ ed.school }}{% endif %}{% if ed.start or ed.end %}, {{ ed.start }}{% if ed.start and ed.end %} – {% endif %}{{ ed.end }}{% endif %}</div>
      {% if ed.gpa %}<div style="color:#555555;">{{ t('GPA') }} {{ ed.gpa }}</div>{% endif %}
      {% for b in ed.bullets %}<div style="color:#555555;">{{ b }}</div>{% endfor %}
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.languages %}
  <div>
    <div style="{{ HEAD }}">{{ t('LANGUAGES') }}</div>
    <div style="font-size:12px; color:#111111; line-height:1.7;">
      {% for lang in r.languages %}{{ lang.name }} — {{ lang.level }}{% if not loop.last %} · {% endif %}{% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.recognition %}
  <div>
    <div style="{{ HEAD }}">{{ t('CERTIFICATIONS') }}</div>
    <div style="font-size:12px; color:#111111; line-height:1.6;">
      {% for rec in r.recognition %}<div>{{ rec.title }}{% if rec.detail %} — {{ rec.detail }}{% endif %}</div>{% endfor %}
    </div>
  </div>
  {% endif %}
</div>
