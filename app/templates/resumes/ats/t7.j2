{# ATS Template 7 — Accent Band · single column · full-width navy masthead, linear body
   Ported from block <!-- 7 --> / id="t7" of "ATS Resume Templates Coded.dc.html".
   Locked spec: ink #151A22, navy #0E2D55, masthead tints #9FB8D4 / #D3DEEB,
   skill hairline #E4E7EC. Archivo 900 heads (14px / 1.6px, navy) + Open Sans body.
   ATS-safe: one column; the navy band is the only fill; skills are "name  Level"
   rows with a hairline under each — level is real text, no graphic.

   Divergences from ref (full-width navy masthead reference):
     1. Palette — ink + navy #0E2D55 on white, masthead tints cooled.
     2. Type — Archivo 900 + Open Sans, not one grotesque.
     3. Contact set on one masthead line, pipe-separated.
     4. Ref shows only Education + Certifications after Skills; Tools and
        Languages, when present, are added as one-line sections in the same
        head style rather than dropped.
     5. Body flex gap 16->13 and body padding 26/34->24/30 to seat the shared
        sample (creative lead, 3 roles, 5 skills, + tools/langs) on one page.
     6. Body padding-bottom 30->17. The flex body ran 13px past the 1100px page
        box: `.tpl` does not clip, so that exported a 2-PAGE PDF while looking
        perfect on screen. Integer `.tpl.scrollHeight` reported 1100 and hid it;
        found by tools/verify_autofit.py. #}
{% set HEAD = "font-family:Archivo,sans-serif; font-weight:900; font-size:14px; letter-spacing:1.6px; color:#0E2D55; margin-bottom:7px;" %}
<div class="tpl" style="box-sizing:border-box; width:850px; height:1100px; background:#ffffff; display:flex; flex-direction:column; font-family:'Open Sans',sans-serif; color:#151A22;">

  <div style="box-sizing:border-box; flex-shrink:0; background:#0E2D55; color:#ffffff; padding:34px 60px 30px;">
    <div class="cv-name" style="font-family:Archivo,sans-serif; font-weight:900; font-size:42px; line-height:1.02; letter-spacing:-1px; text-transform:uppercase;">{{ r.name }}</div>
    {% if r.title %}<div style="font-size:14px; font-weight:600; letter-spacing:3.4px; text-transform:uppercase; color:#9FB8D4; margin-top:8px;">{{ r.title }}</div>{% endif %}
    {% set c = r.contact %}{% set bits = [] %}
    {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
    {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
    {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
    {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
    {% for s in c.social %}{% if s.label %}{% set _ = bits.append(s.label) %}{% endif %}{% endfor %}
    {% if bits %}<div style="font-size:12px; color:#D3DEEB; margin-top:12px; line-height:1.6;">{{ bits | join(" | ") }}</div>{% endif %}
  </div>

  <div style="box-sizing:border-box; flex:1; min-width:0; padding:24px 60px 17px; display:flex; flex-direction:column; gap:13px;">

    {% if r.summary %}
    <div>
      <div class="cv-section" style="{{ HEAD }}">{{ t('SUMMARY') }}</div>
      <p style="margin:0; font-size:12px; line-height:1.6;">{{ r.summary }}</p>
    </div>
    {% endif %}

    {% if r.achievements %}
    <div>
      <div class="cv-section" style="{{ HEAD }}">{{ t('KEY ACHIEVEMENTS') }}</div>
      <div style="font-size:12px; line-height:1.75;">
        {% for a in r.achievements %}
        <div><span style="font-weight:700; color:#0E2D55;">{{ a.metric }}</span> — {{ a.label }}</div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.experience %}
    <div>
      <div class="cv-section" style="{{ HEAD }} margin-bottom:9px;">{{ t('EXPERIENCE') }}</div>
      <div style="display:flex; flex-direction:column; gap:12px;">
        {% for job in r.experience %}
        <div>
          <div style="display:flex; justify-content:space-between; align-items:baseline; gap:14px;">
            <span style="font-weight:700; font-size:13px;">{{ job.role }}</span>
            {% if job.start or job.end %}<span style="font-size:11.5px; color:#5A606B; white-space:nowrap;">{{ job.start }}{% if job.start and job.end %} – {% endif %}{{ job.end }}</span>{% endif %}
          </div>
          {% if job.company or job.location %}<div style="font-size:12px; color:#0E2D55; margin:2px 0 4px;">{{ job.company }}{% if job.company and job.location %}, {% endif %}{{ job.location }}</div>{% endif %}
          {% if job.bullets %}
          <ul style="margin:0; padding-inline-start:17px; font-size:12px; line-height:1.55;">
            {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
          </ul>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.skills %}
    <div>
      <div class="cv-section" style="{{ HEAD }}">{{ t('SKILLS') }}</div>
      <div style="display:flex; flex-direction:column; gap:5px; font-size:12px;">
        {% for sk in r.skills %}
        <div style="display:flex; justify-content:space-between; gap:14px;{% if not loop.last %} border-bottom:1px solid #E4E7EC; padding-bottom:4px;{% endif %}"><span>{{ sk.name }}</span><span style="font-weight:700; color:#0E2D55;">{{ sk.level }}</span></div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.education %}
    <div>
      <div class="cv-section" style="{{ HEAD }}">{{ t('EDUCATION') }}</div>
      <div style="font-size:12px; line-height:1.65;">
        {% for ed in r.education %}
        <div><b>{{ ed.degree }}</b>{% if ed.school %} — {{ ed.school }}{% endif %}{% if ed.start or ed.end %}, {{ ed.start }}{% if ed.start and ed.end %} – {% endif %}{{ ed.end }}{% endif %}</div>
        {% if ed.gpa %}<div style="color:#5A606B;">{{ t('GPA') }} {{ ed.gpa }}</div>{% endif %}
        {% for b in ed.bullets %}<div style="color:#5A606B;">{{ b }}</div>{% endfor %}
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.recognition %}
    <div>
      <div class="cv-section" style="{{ HEAD }}">{{ t('CERTIFICATIONS') }}</div>
      <div style="font-size:12px; line-height:1.65;">
        {% for rec in r.recognition %}<div>{{ rec.title }}{% if rec.detail %} — {{ rec.detail }}{% endif %}</div>{% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.tools %}
    <div>
      <div class="cv-section" style="{{ HEAD }}">{{ t('TOOLS') }}</div>
      <div style="font-size:12px; line-height:1.65;">{{ r.tools | join(" · ") }}</div>
    </div>
    {% endif %}

    {% if r.languages %}
    <div>
      <div class="cv-section" style="{{ HEAD }}">{{ t('LANGUAGES') }}</div>
      <div style="font-size:12px; line-height:1.65;">{% for l in r.languages %}{{ l.name }} — {{ l.level }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
    </div>
    {% endif %}
  </div>
</div>
