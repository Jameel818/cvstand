{# ATS Template 11 — Caps Tick · single column · teal accent, tick-marked section labels
   Ported from block <!-- 11 --> / id="t11" of "ATS Resume Templates Coded.dc.html".
   Locked spec: ink #14201E, teal #0F766E, tint text #4E5A57. Montserrat 800 for
   the name and every section label; Open Sans body. Each section label is a
   22×4px teal tick followed by Montserrat 800 12.5px / 2.6px uppercase text.
   Name Montserrat 800 38px, no masthead rule. Skills and Languages are
   "name  Level" rows, level in teal — real text, no graphic. ATS-safe: single
   column, the tick is the only fill.

   Divergences from ref (tick-marked caps reference):
     1. Palette — ink #14201E + teal #0F766E on white.
     2. Type — Montserrat 800 + Open Sans.
     3. Contact on one masthead line, pipe-separated.
     4. Ref ends Summary / KeyAch / Exp / Skills / Edu+Certs / Languages; Tools,
        when present, is added as its own tick section in the same rhythm. #}
{% macro tick(label) %}
<div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;"><span style="width:22px; height:4px; background:#0F766E;"></span><span class="cv-section" style="font-family:Montserrat,sans-serif; font-weight:800; font-size:12.5px; letter-spacing:2.6px; text-transform:uppercase;">{{ label }}</span></div>
{% endmacro %}
<div class="tpl" style="box-sizing:border-box; width:850px; height:1100px; background:#ffffff; padding:56px 66px; display:flex; flex-direction:column; gap:18px; font-family:'Open Sans',sans-serif; color:#14201E;">

  <div>
    <div class="cv-name" style="font-family:Montserrat,sans-serif; font-weight:800; font-size:38px; line-height:1.08; letter-spacing:-0.6px;">{{ r.name }}</div>
    {% if r.title %}<div style="font-size:13.5px; font-weight:600; letter-spacing:3.2px; text-transform:uppercase; color:#0F766E; margin-top:8px;">{{ r.title }}</div>{% endif %}
    {% set c = r.contact %}{% set bits = [] %}
    {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
    {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
    {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
    {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
    {% for s in c.social %}{% if s.label %}{% set _ = bits.append(s.label) %}{% endif %}{% endfor %}
    {% if bits %}<div style="font-size:12px; color:#4E5A57; margin-top:9px; line-height:1.6;">{{ bits | join(" | ") }}</div>{% endif %}
  </div>

  {% if r.summary %}
  <div>
    {{ tick(t("Summary")) }}
    <p style="margin:0; font-size:12px; line-height:1.65;">{{ r.summary }}</p>
  </div>
  {% endif %}

  {% if r.achievements %}
  <div>
    {{ tick(t("Key Achievements")) }}
    <div style="font-size:12px; line-height:1.75;">
      {% for a in r.achievements %}
      <div><span style="font-weight:700; color:#0F766E;">{{ a.metric }}</span> — {{ a.label }}</div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.experience %}
  <div>
    {{ tick(t("Experience")) }}
    <div style="display:flex; flex-direction:column; gap:12px;">
      {% for job in r.experience %}
      <div>
        <div style="display:flex; justify-content:space-between; align-items:baseline; gap:14px;">
          <span style="font-family:Montserrat,sans-serif; font-weight:700; font-size:13px;">{{ job.role }}</span>
          {% if job.start or job.end %}<span style="font-size:11.5px; color:#5A6663; white-space:nowrap;">{{ job.start }}{% if job.start and job.end %} – {% endif %}{{ job.end }}</span>{% endif %}
        </div>
        {% if job.company or job.location %}<div style="font-size:12px; color:#0F766E; margin:2px 0 4px;">{{ job.company }}{% if job.company and job.location %}, {% endif %}{{ job.location }}</div>{% endif %}
        {% if job.bullets %}
        <ul style="margin:0; padding-inline-start:17px; font-size:12px; line-height:1.55;">
          {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.skills %}
  <div>
    {{ tick(t("Skills")) }}
    <div style="display:flex; flex-direction:column; gap:5px; font-size:12px;">
      {% for sk in r.skills %}
      <div style="display:flex; gap:12px;"><span style="width:225px; flex-shrink:0;">{{ sk.name }}</span><span style="font-weight:700; color:#0F766E;">{{ sk.level }}</span></div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.education or r.recognition %}
  <div>
    {{ tick(t("Education and Certifications") if r.recognition else t("Education")) }}
    <div style="font-size:12px; line-height:1.7;">
      {% for ed in r.education %}
      <div><b>{{ ed.degree }}</b>{% if ed.school %} — {{ ed.school }}{% endif %}{% if ed.start or ed.end %}, {{ ed.start }}{% if ed.start and ed.end %} – {% endif %}{{ ed.end }}{% endif %}{% if ed.gpa %} &nbsp;·&nbsp; {{ t('GPA') }} {{ ed.gpa }}{% endif %}</div>
      {% for b in ed.bullets %}<div style="color:#4E5A57;">{{ b }}</div>{% endfor %}
      {% endfor %}
      {% if r.recognition %}<div style="color:#4E5A57;">{% for rec in r.recognition %}{{ rec.title }}{% if rec.detail %}, {{ rec.detail }}{% endif %}{% if not loop.last %} &nbsp;·&nbsp; {% endif %}{% endfor %}</div>{% endif %}
    </div>
  </div>
  {% endif %}

  {% if r.languages %}
  <div>
    {{ tick(t("Languages")) }}
    <div style="display:flex; flex-direction:column; gap:5px; font-size:12px;">
      {% for l in r.languages %}
      <div style="display:flex; gap:12px;"><span style="width:225px; flex-shrink:0;">{{ l.name }}</span><span style="font-weight:700; color:#0F766E;">{{ l.level }}</span></div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.tools %}
  <div>
    {{ tick(t("Tools")) }}
    <div style="font-size:12px; line-height:1.7;">{{ r.tools | join(" · ") }}</div>
  </div>
  {% endif %}
</div>
