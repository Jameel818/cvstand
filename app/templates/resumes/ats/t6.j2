{# ATS Template 6 — Rule Stack · single column · steel accent, hairline sections
   Ported from block <!-- 6 --> / id="t6" of "ATS Resume Templates Coded.dc.html".
   Locked spec: ink #111318, steel #1F4E79, hairline #C9CDD4, Source Sans 3 body +
   Archivo heads. ATS-safe: single column, skills as "name  Level" text (no graphic). #}
{% set HEAD = "font-family:Archivo,sans-serif; font-weight:800; font-size:13px; letter-spacing:2px; color:#1F4E79; padding-bottom:6px; border-bottom:1px solid #C9CDD4; margin-bottom:9px;" %}
<div class="tpl" style="box-sizing:border-box; width:850px; height:1100px; background:#ffffff; padding:48px 68px; display:flex; flex-direction:column; gap:13px; font-family:'Source Sans 3',sans-serif; color:#111318;">

  <div>
    <div class="cv-name" style="font-family:Archivo,sans-serif; font-weight:900; font-size:40px; line-height:1.02; letter-spacing:-1px; text-transform:uppercase;">{{ r.name }}</div>
    {% if r.title %}<div style="font-size:14px; font-weight:600; letter-spacing:3px; text-transform:uppercase; color:#1F4E79; margin-top:7px;">{{ r.title }}</div>{% endif %}
    {% set c = r.contact %}{% set bits = [] %}
    {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
    {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
    {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
    {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
    {% if bits %}<div style="font-size:12px; color:#54585F; margin-top:8px; line-height:1.6;">{{ bits | join(" | ") }}</div>{% endif %}
  </div>
  <div style="height:2px; background:#111318;"></div>

  {% if r.summary %}
  <div><div class="cv-section" style="{{ HEAD }}">{{ t('SUMMARY') }}</div>
    <p style="margin:0; font-size:12px; line-height:1.6;">{{ r.summary }}</p>
  </div>
  {% endif %}

  {% if r.achievements %}
  <div><div class="cv-section" style="{{ HEAD }}">{{ t('KEY ACHIEVEMENTS') }}</div>
    <div style="font-size:12px; line-height:1.75;">
      {% for a in r.achievements %}<div><span style="font-weight:700; color:#1F4E79;">{{ a.metric }}</span> — {{ a.label }}</div>{% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.experience %}
  <div><div class="cv-section" style="{{ HEAD }} margin-bottom:10px;">{{ t('EXPERIENCE') }}</div>
    <div style="display:flex; flex-direction:column; gap:12px;">
      {% for job in r.experience %}
      <div>
        <div style="display:flex; justify-content:space-between; align-items:baseline; gap:14px;">
          <span style="font-family:Archivo,sans-serif; font-weight:700; font-size:13px;">{{ job.role }}</span>
          {% if job.start or job.end %}<span style="font-size:11.5px; color:#54585F; white-space:nowrap;">{{ job.start }}{% if job.start and job.end %} – {% endif %}{{ job.end }}</span>{% endif %}
        </div>
        {% if job.company or job.location %}<div style="font-size:12px; color:#33373E; margin:2px 0 4px;">{{ job.company }}{% if job.company and job.location %}, {% endif %}{{ job.location }}</div>{% endif %}
        {% if job.bullets %}
        <ul style="margin:0; padding-inline-start:17px; font-size:12px; line-height:1.55;">
          {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.skills %}
  <div><div class="cv-section" style="{{ HEAD }}">{{ t('SKILLS') }}</div>
    <div style="display:flex; flex-direction:column; gap:5px; font-size:12px;">
      {% for sk in r.skills %}
      <div style="display:flex; gap:12px;"><span style="width:220px; flex-shrink:0;">{{ sk.name }}</span><span style="font-weight:700;">{{ sk.level }}</span></div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.tools %}
  <div><div class="cv-section" style="{{ HEAD }}">{{ t('TOOLS') }}</div>
    <div style="font-size:12px; line-height:1.65;">{{ r.tools | join(" · ") }}</div>
  </div>
  {% endif %}

  {% if r.education %}
  <div><div class="cv-section" style="{{ HEAD }}">{{ t('EDUCATION') }}</div>
    <div style="font-size:12px; line-height:1.65;">
      {% for ed in r.education %}
      <div><b>{{ ed.degree }}</b>{% if ed.school %} — {{ ed.school }}{% endif %}{% if ed.start or ed.end %}, {{ ed.start }}{% if ed.start and ed.end %} – {% endif %}{{ ed.end }}{% endif %}</div>
      {% if ed.gpa %}<div style="color:#54585F;">{{ t('GPA') }} {{ ed.gpa }}</div>{% endif %}
      {% for b in ed.bullets %}<div style="color:#54585F;">{{ b }}</div>{% endfor %}
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if r.languages %}
  <div><div class="cv-section" style="{{ HEAD }}">{{ t('LANGUAGES') }}</div>
    <div style="font-size:12px; line-height:1.65;">{% for l in r.languages %}{{ l.name }} — {{ l.level }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
  </div>
  {% endif %}

  {% if r.recognition %}
  <div><div class="cv-section" style="{{ HEAD }}">{{ t('CERTIFICATIONS') }}</div>
    <div style="font-size:12px; line-height:1.65;">
      {% for rec in r.recognition %}<div>{{ rec.title }}{% if rec.detail %} — {{ rec.detail }}{% endif %}</div>{% endfor %}
    </div>
  </div>
  {% endif %}
</div>
