{# Modern Template 18 — Interlocking Block · two-field (absolute) · straddling photo, banded skill bars
   Ported from block <!-- 18 --> / id="t18" of "Resume Templates Coded.dc.html".
   Locked spec: two interlocking #002B66 navy blocks (left-bottom + right-top)
   on white; a white-matted photo straddling the tone seam; left navy column
   carries Contact (kicker/value tiles, brass #C08A2E kickers) and Education;
   right column opens with an Archivo 900 name over the navy header, then a
   white area with an Anton-numeral stat band, Work Experience (navy caps role
   lines), and a bottom-pinned Skills block of pill bars (track #DCDEE4 / fill
   #002B66) each ending in a navy level word as real text. Open Sans body.

   Divergences from the supplied reference (image closed before design):
     1. Palette — navy #002B66 + brass #C08A2E on white, not the reference's
        black/grey achromatic. Locked here.
     2. Type — Archivo 900 display + Anton stat numerals + Open Sans body, not
        one geometric rounded grotesque.
     3. Structure — contact icon tiles become typographic kicker/value pairs;
        skill bars carry a level word as real selectable text (navy on the white
        side for 4.5:1, not brass which only clears 3:1 there); a quantified
        stat band opens the right column where the reference has none.
     4. Name is one data string, so it is set at 44px (not the reference 62px
        two-line lockup) and wraps naturally; the photo straddle is kept.
     5. `.tpl` is overflow:hidden with an absolute two-tone frame + flex
        columns — verified by screenshot + panel measurement, not `.tpl`
        scrollHeight. Right white-area gap 18->16, section gaps trimmed to seat
        the shared sample; Skills stays pinned to the column bottom. #}
{% set LH = "font-family:Archivo,sans-serif; font-weight:900; font-size:23px; letter-spacing:-0.2px; color:#ffffff;" %}
{% set RH = "font-family:Archivo,sans-serif; font-weight:900; font-size:23px; letter-spacing:-0.2px; color:#002B66;" %}
{# kicker lifted from the brand brass #C08A2E to #C9973A so 9.5px labels clear
   4.5:1 on the #002B66 navy; #C08A2E stays on the larger brass elements. #}
{% set FLD = "font-size:9.5px; letter-spacing:1.6px; font-weight:700; text-transform:uppercase; color:#C9973A;" %}
{% set VAL = "font-size:12.5px; color:#E3E9F2; margin-top:3px; overflow-wrap:anywhere;" %}
<div class="tpl cv-sections-taj" style="box-sizing:border-box; position:relative; width:850px; height:1100px; background:#ffffff; overflow:hidden; font-family:'Open Sans',sans-serif; color:#26303C;">

  <div style="position:absolute; inset-inline-start:0; top:312px; width:372px; bottom:0; background:#002B66;"></div>
  <div style="position:absolute; inset-inline-start:372px; top:0; inset-inline-end:0; height:312px; background:#002B66;"></div>

  <div style="position:absolute; inset:0; display:flex;">

    <div style="box-sizing:border-box; width:372px; flex-shrink:0; position:relative; padding:0 42px;">
      <div style="position:absolute; inset-inline-start:30px; top:34px; width:312px; height:300px; background:#ffffff; padding:12px; box-sizing:border-box;">
        <div style="width:100%; height:100%; background:#C8CEDA; overflow:hidden; display:flex; align-items:center; justify-content:center; color:#5B6472; font-size:12px;">
          {% if r.photo_url %}<img src="{{ r.photo_url }}" alt="" style="width:100%; height:100%; object-fit:cover; display:block;">{% else %}{{ t('Photo') }}{% endif %}
        </div>
      </div>
      <div style="padding-top:372px; display:flex; flex-direction:column; gap:26px;">

        {% set c = r.contact %}
        {% if c.email or c.phone or c.address or c.site or c.social %}
        <div>
          <div class="cv-section" style="{{ LH }}">{{ t('Contact') }}</div>
          <div style="height:1px; background:rgba(255,255,255,0.38); margin:11px 0 15px;"></div>
          <div style="display:flex; flex-direction:column; gap:12px;">
            {% if c.email %}<div><div style="{{ FLD }}">{{ t('Email') }}</div><div style="{{ VAL }}">{{ c.email }}</div></div>{% endif %}
            {% if c.phone %}<div><div style="{{ FLD }}">{{ t('Phone') }}</div><div style="{{ VAL }}">{{ c.phone }}</div></div>{% endif %}
            {% if c.address %}<div><div style="{{ FLD }}">{{ t('Location') }}</div><div style="{{ VAL }}">{{ c.address }}</div></div>{% endif %}
            {% if c.site %}<div><div style="{{ FLD }}">{{ t('Portfolio') }}</div><div style="{{ VAL }}">{{ c.site }}</div></div>{% endif %}
            {% for s in c.social %}{% if s.label %}<div><div style="{{ FLD }}">{{ t('Link') }}</div><div style="{{ VAL }}">{{ s.label }}</div></div>{% endif %}{% endfor %}
          </div>
        </div>
        {% endif %}

        {% if r.education %}
        <div>
          <div class="cv-section" style="{{ LH }}">{{ t('Education') }}</div>
          <div style="height:1px; background:rgba(255,255,255,0.38); margin:11px 0 15px;"></div>
          <div style="display:flex; flex-direction:column; gap:18px;">
            {% for ed in r.education %}
            <div>
              {% if ed.start or ed.end %}<div style="font-size:11px; color:#9FB0C8;">{{ ed.start }}{% if ed.start and ed.end %} – {% endif %}{{ ed.end }}</div>{% endif %}
              <div style="font-weight:700; font-size:14px; color:#ffffff; margin-top:2px;">{{ ed.degree }}</div>
              {% if ed.school %}<div style="font-size:12.5px; color:#C4D0E2;">{{ ed.school }}</div>{% endif %}
              {% if ed.bullets %}
              <ul style="margin:8px 0 0; padding-inline-start:15px; font-size:12px; line-height:1.55; color:#DBE3EE;">
                {% for b in ed.bullets %}<li>{{ b }}</li>{% endfor %}
              </ul>
              {% endif %}
            </div>
            {% endfor %}
          </div>
        </div>
        {% endif %}

      </div>
    </div>

    <div style="flex:1; min-width:0; display:flex; flex-direction:column;">

      <div style="box-sizing:border-box; height:312px; flex-shrink:0; padding:38px 40px 0 40px;">
        <div class="cv-name" style="font-family:Archivo,sans-serif; font-weight:900; font-size:44px; line-height:1.04; letter-spacing:-1px; color:#ffffff; text-transform:uppercase;">{{ r.name }}</div>
        {% if r.title %}<div style="font-size:14px; font-weight:600; letter-spacing:3px; text-transform:uppercase; color:#C08A2E; margin-top:10px;">{{ r.title }}</div>{% endif %}
        {% if r.summary %}
        <div style="height:1px; background:rgba(255,255,255,0.42); margin:16px 0 13px;"></div>
        <div style="font-size:12px; line-height:1.65; color:#D2DCEA;">{{ r.summary }}</div>
        {% endif %}
      </div>

      <div style="flex:1; min-width:0; padding:24px 40px 24px 40px; display:flex; flex-direction:column; gap:16px;">

        {% if r.achievements %}
        <div style="display:grid; grid-auto-flow:column; grid-auto-columns:minmax(0,1fr); gap:14px; border-bottom:1px solid #DDDBD3; padding-bottom:12px;">
          {% for a in r.achievements %}
          {% if a.metric %}
          <div>
            <div style="font-family:Anton,sans-serif; font-size:24px; line-height:1; color:#C08A2E;">{{ a.metric }}</div>
            <div style="font-size:8.5px; letter-spacing:1px; font-weight:700; text-transform:uppercase; color:#6E7787; margin-top:5px;">{{ a.label }}</div>
          </div>
          {% endif %}
          {% endfor %}
        </div>
        {% endif %}

        {% if r.experience %}
        <div>
          <div class="cv-section" style="{{ RH }}">{{ t('Work Experience') }}</div>
          <div style="height:1px; background:#C9C6BC; margin:10px 0 14px;"></div>
          <div style="display:flex; flex-direction:column; gap:13px;">
            {% for job in r.experience %}
            <div>
              {% if job.start or job.end %}<div style="font-size:11px; color:#8B93A0;">{{ job.start }}{% if job.start and job.end %} – {% endif %}{{ job.end }}</div>{% endif %}
              <div style="font-weight:700; font-size:14px; color:#002B66; text-transform:uppercase; letter-spacing:0.3px; margin-top:2px;">{{ job.role }}</div>
              {% if job.company or job.location %}<div style="font-size:12.5px; color:#4C5666;">{{ job.company }}{% if job.company and job.location %} · {{ job.location }}{% elif job.location %}{{ job.location }}{% endif %}</div>{% endif %}
              {% if job.bullets %}
              <ul style="margin:7px 0 0; padding-inline-start:16px; font-size:12px; line-height:1.55; color:#39424E;">
                {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
              </ul>
              {% endif %}
            </div>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        {% if r.skills %}
        <div style="margin-top:auto;">
          <div class="cv-section" style="{{ RH }}">{{ t('Skills') }}</div>
          <div style="height:1px; background:#C9C6BC; margin:10px 0 14px;"></div>
          <div style="display:flex; flex-direction:column; gap:8px;">
            {% for sk in r.skills %}
            {% set _pc = sk.get('percent') %}
            {% set pct = _pc if _pc is not none else (sk.dots / sk.dot_total * 100) | round | int %}
            <div style="display:flex; align-items:center; gap:12px;">
              <span style="width:124px; flex-shrink:0; font-size:12.5px; font-weight:600; color:#002B66;">{{ sk.name }}</span>
              {% if sk.level or _pc is not none %}<span style="flex:1; min-width:0; height:9px; background:#DCDEE4; border-radius:999px; display:block; overflow:hidden;"><span style="display:block; height:100%; border-radius:999px; width:{{ pct }}%; background:#002B66;"></span></span>{% endif %}
              <span style="width:64px; flex-shrink:0; text-align:end; font-size:10.5px; font-weight:700; letter-spacing:0.3px; color:#002B66;">{{ (_pc ~ '%') if _pc is not none else sk.level }}</span>
            </div>
            {% endfor %}
          </div>
        </div>
        {% endif %}

      </div>
    </div>

  </div>
</div>
