{# Template 1 — Pure white, rules only · creative lead · dot-grid levels, redline marker
   Ported from block <!-- 1 --> / id="t1" of "Resume Templates Coded.dc.html".
   Locked spec: ink #16161A, chartreuse marker #D8F035, Archivo 900 + Source Sans 3,
   dot-grid skill levels, four-chip metric band, 70/30 body split with a hairline.
   Emits ONLY the .tpl canvas div. #}
{% import "_macros.j2" as m %}
{% set H = "font-family:Archivo,sans-serif; font-weight:900; font-size:15px; letter-spacing:2.2px; text-transform:uppercase;" %}
{% set name_parts = r.name.split(" ", 1) %}
<div class="tpl" style="box-sizing:border-box; width:850px; height:1100px; background:#ffffff; padding:64px 60px 56px; font-family:'Source Sans 3',sans-serif; color:#16161A; display:flex; flex-direction:column; gap:21px;">

  <div>
    <div class="cv-name" style="font-family:Archivo,sans-serif; font-weight:900; font-size:64px; line-height:0.94; letter-spacing:-2.2px; text-transform:uppercase;">{{ name_parts[0] }}{% if name_parts|length > 1 %}<br>{{ name_parts[1] }}{% endif %}</div>
    {% if r.summary %}
    <div style="font-size:16px; line-height:1.6; color:#3A3A42; margin-top:14px; max-width:560px;">
      {%- if r.summary_highlight and r.summary_highlight in r.summary -%}
        {%- set around = r.summary.split(r.summary_highlight, 1) -%}
        {{ around[0] }}<span style="background:#D8F035; padding:1px 5px;">{{ r.summary_highlight }}</span>{{ around[1] }}
      {%- else -%}
        {{ r.summary }}
      {%- endif -%}
    </div>
    {% endif %}
  </div>

  {{ m.stat_band(r.achievements) }}

  <div style="flex:1; min-width:0; display:flex; gap:34px;">

    <div style="flex:1; min-width:0; display:flex; flex-direction:column; gap:32px;">
      {% if r.experience %}
      <div>
        <div class="cv-section" style="{{ H }} margin-bottom:14px;">{{ t('Experience') }}</div>
        <div style="display:flex; flex-direction:column; gap:20px;">
          {% for job in r.experience %}
          {{ m.experience_entry(job) }}
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if r.recognition %}
      <div>
        <div class="cv-section" style="{{ H }} margin-bottom:12px;">{{ t('Recognition') }}</div>
        <div style="display:flex; flex-direction:column; gap:8px; font-size:12.5px; line-height:1.5;">
          {% for rec in r.recognition %}
          <div><b>{{ rec.title }}</b>{% if rec.detail %} — {{ rec.detail }}{% endif %}</div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if r.education %}
      <div>
        <div class="cv-section" style="{{ H }} margin-bottom:12px;">{{ t('Education') }}</div>
        <div style="display:flex; flex-direction:column; gap:10px; font-size:12.5px; line-height:1.5;">
          {% for ed in r.education %}
          {{ m.education_entry(ed) }}
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </div>

    <div style="width:236px; flex-shrink:0; border-inline-start:1px solid #D6D6DA; padding-inline-start:30px; display:flex; flex-direction:column; gap:51px;">
      {% if r.contact and (r.contact.email or r.contact.phone or r.contact.address or r.contact.site or r.contact.social) %}
      <div>
        <div class="cv-section" style="{{ H }} margin-bottom:12px;">{{ t('Contact') }}</div>
        {{ m.contact_lines(r.contact) }}
      </div>
      {% endif %}

      {% if r.skills %}
      <div>
        <div class="cv-section" style="{{ H }} margin-bottom:12px;">{{ t('Capabilities') }}</div>
        <div style="display:flex; flex-direction:column; gap:11px;">
          {% for sk in r.skills %}
          {{ m.skill_dotrow(sk) }}
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if r.tools %}
      <div>
        <div class="cv-section" style="{{ H }} margin-bottom:12px;">{{ t('Tools') }}</div>
        <div style="display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:7px 14px; font-size:12px; color:#3A3A42;">
          {% for tool in r.tools %}<div>{{ tool }}</div>{% endfor %}
        </div>
      </div>
      {% endif %}

      {% if r.languages %}
      <div>
        <div class="cv-section" style="{{ H }} margin-bottom:12px;">{{ t('Languages') }}</div>
        <div style="font-size:12.5px; line-height:1.7; color:#3A3A42;">
          {% for lang in r.languages %}{{ lang.name }} — {{ lang.level }}{% if not loop.last %}<br>{% endif %}{% endfor %}
        </div>
      </div>
      {% endif %}
    </div>

  </div>
</div>
