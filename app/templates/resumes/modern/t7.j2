{# Modern Template 7 — Poster Band · two-tone body · early-career, bar levels
   Ported from block <!-- 7 --> / id="t7" of "Resume Templates Coded.dc.html".
   Locked spec: poster masthead — #FFD500 yellow block (520x300) beside a #D9D9D9
   panel with a 5px white inset; body two-tone — oat/white left column, oxblood
   #001D3D right column from y=300 down. Anton for the 74px name and stat
   numerals, Archivo 900 21px section heads, Poppins body. Left heads #001D3D;
   right heads/labels #FFFFFF on oxblood, values #DFDEDD, dates #FFD500. Skill
   bars on the inset-inline-end: track #123A63, fill #FFD500, level word as real text.

   Divergences from ref B (poster header band + two-tone body):
     1. Palette — oxblood #001D3D + oat #F3F2DB + #FFD500, not slate blue/grey.
     2. Type — Anton + Poppins, not one slab grotesque.
     3. The icon-and-word skill grid becomes named bar rows with the level word
        as real selectable text; a stat band replaces the objective whitespace.
     4. Left "Training" is fed by r.recognition; experience bodies render the
        bullet list (the data model has bullets, not the reference's one-line
        blurb).
     5. Section gaps 43 (left) / 72 (right) -> 18 / 20 so the dense shared sample
        fits inside the fixed 300px-offset body panels without clipping. #}
<div class="tpl" style="box-sizing:border-box; position:relative; width:850px; height:1100px; background:#ffffff; overflow:hidden; font-family:Poppins,sans-serif; color:#4A4C4A;">
  <div style="position:absolute; inset-inline-start:0; top:0; width:520px; height:300px; background:#FFD500;"></div>
  <div style="position:absolute; inset-inline-start:520px; top:0; inset-inline-end:0; height:300px; background:#D9D9D9; border:5px solid #ffffff; box-sizing:border-box; overflow:hidden;">
    {% if r.photo_url %}<img src="{{ r.photo_url }}" alt="" style="width:100%; height:100%; object-fit:cover; display:block;">{% endif %}
  </div>
  <div style="position:absolute; inset-inline-start:520px; top:300px; inset-inline-end:0; bottom:0; background:#001D3D;"></div>

  <div style="box-sizing:border-box; position:absolute; inset-inline-start:0; top:0; width:520px; height:300px; padding-block: 44px 0; padding-inline: 44px 40px;">
    {% set nm = r.name.split(" ", 1) %}
    <div class="cv-name" style="font-family:Anton,sans-serif; font-size:70px; line-height:0.92; letter-spacing:1px; text-transform:uppercase; color:#001D3D;">{{ nm[0] }}{% if nm|length > 1 %}<br>{{ nm[1] }}{% endif %}</div>
    {% if r.title %}<div style="font-size:17px; font-weight:600; letter-spacing:2px; text-transform:uppercase; color:#4A4C4A; margin-top:14px;">{{ r.title }}</div>{% endif %}
  </div>

  {% set LH = "font-family:Archivo,sans-serif; font-weight:900; font-size:21px; letter-spacing:0.5px; text-transform:uppercase; color:#001D3D; margin-bottom:10px;" %}
  {% set RH = "font-family:Archivo,sans-serif; font-weight:900; font-size:21px; letter-spacing:0.5px; text-transform:uppercase; color:#ffffff; margin-bottom:12px;" %}

  <div style="box-sizing:border-box; position:absolute; inset-inline-start:0; top:300px; width:520px; bottom:0; padding-block: 30px 26px; padding-inline: 44px 40px; display:flex; flex-direction:column; gap:18px;">

    {% if r.summary %}
    <div>
      <div class="cv-section" style="{{ LH }}">{{ t('Career Objective') }}</div>
      <div style="font-size:12.5px; line-height:1.65; color:#4A4C4A;">{{ r.summary }}</div>
    </div>
    {% endif %}

    {% if r.achievements %}
    <div style="display:grid; grid-auto-flow:column; grid-auto-columns:minmax(0,1fr); gap:10px; border-top:1px solid #9F9F9E; border-bottom:1px solid #9F9F9E; padding:11px 0;">
      {% for a in r.achievements %}
      <div>
        <div style="font-family:Anton,sans-serif; font-size:23px; color:#001D3D;">{{ a.metric }}</div>
        <div style="font-size:9px; letter-spacing:1px; font-weight:700; text-transform:uppercase; color:#4A4C4A; margin-top:4px;">{{ a.label }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if r.experience %}
    <div>
      <div class="cv-section" style="{{ LH }}">{{ t('Experience') }}</div>
      <div style="display:flex; flex-direction:column; gap:12px;">
        {% for job in r.experience %}
        <div>
          <div style="font-weight:700; font-size:14px; color:#001D3D;">{{ job.role }}</div>
          {% if job.company or job.location or job.start or job.end %}
          <div style="font-size:11.5px; color:#4A4C4A; margin:2px 0 5px;">{{ job.company }}{% if job.company and job.location %} · {% endif %}{{ job.location }}{% if (job.company or job.location) and (job.start or job.end) %} · {% endif %}{{ job.start }}{% if job.start and job.end %} – {% endif %}{{ job.end }}</div>
          {% endif %}
          {% if job.bullets %}
          <ul style="margin:0; padding-inline-start:15px; font-size:11.5px; line-height:1.55; color:#4A4C4A;">
            {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
          </ul>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.recognition %}
    <div>
      <div class="cv-section" style="{{ LH }}">{{ t('Training') }}</div>
      <div style="display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px 18px; font-size:12px; line-height:1.45; color:#4A4C4A;">
        {% for rec in r.recognition %}
        <div><b style="color:#001D3D;">{{ rec.title }}</b>{% if rec.detail %}<br>{{ rec.detail }}{% endif %}</div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>

  <div style="box-sizing:border-box; position:absolute; inset-inline-start:520px; top:300px; inset-inline-end:0; bottom:0; padding-block: 30px 26px; padding-inline: 36px 40px; color:#F3F2DB; display:flex; flex-direction:column; gap:20px;">

    {% if r.skills %}
    <div>
      <div class="cv-section" style="{{ RH }}">{{ t('Skills') }}</div>
      <div style="display:flex; flex-direction:column; gap:10px;">
        {% for sk in r.skills %}
        {% set _pc = sk.get('percent') %}
        {% set pct = _pc if _pc is not none else (sk.dots / sk.dot_total * 100) | round | int %}
        <div>
          <div style="display:flex; justify-content:space-between; font-size:12px;"><span style="font-weight:600; color:#ffffff;">{{ sk.name }}</span><span style="color:#DFDEDD; font-size:10.5px;">{{ (_pc ~ '%') if _pc is not none else sk.level }}</span></div>
          {% if sk.level or _pc is not none %}<div style="height:8px; border-radius:999px; background:#123A63; margin-top:5px; overflow:hidden;"><div style="height:100%; width:{{ pct }}%; border-radius:999px; background:#FFD500;"></div></div>{% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.education %}
    <div>
      <div class="cv-section" style="{{ RH }}">{{ t('Education') }}</div>
      <div style="display:flex; flex-direction:column; gap:8px;">
        {% for ed in r.education %}
        <div>
          <div style="font-weight:700; font-size:14px; color:#ffffff;">{{ ed.degree }}</div>
          {% if ed.school %}<div style="font-size:12px; color:#DFDEDD;">{{ ed.school }}</div>{% endif %}
          {% if ed.start or ed.end or ed.gpa %}<div style="font-size:11.5px; color:#FFD500;">{{ ed.start }}{% if ed.start and ed.end %} – {% endif %}{{ ed.end }}{% if (ed.start or ed.end) and ed.gpa %} · {% endif %}{% if ed.gpa %}{{ t('GPA') }} {{ ed.gpa }}{% endif %}</div>{% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.tools %}
    <div>
      <div class="cv-section" style="{{ RH }}">{{ t('Tools') }}</div>
      <div style="font-size:12px; line-height:1.75; color:#DFDEDD;">{{ r.tools | join(" · ") }}</div>
    </div>
    {% endif %}

    {% if r.languages %}
    <div>
      <div class="cv-section" style="{{ RH }}">{{ t('Languages') }}</div>
      <div style="font-size:12px; line-height:1.85; color:#DFDEDD;">{% for l in r.languages %}{{ l.name }} — {{ l.level }}{% if not loop.last %}<br>{% endif %}{% endfor %}</div>
    </div>
    {% endif %}

    {% set c = r.contact %}
    {% if c.email or c.phone or c.address or c.site or c.social %}
    <div>
      <div class="cv-section" style="{{ RH }}">{{ t('Contact') }}</div>
      <div style="font-size:12px; line-height:1.85; color:#DFDEDD; overflow-wrap:anywhere;">
        {%- set cb = [] -%}
        {% if c.email %}{% set _ = cb.append(c.email) %}{% endif %}
        {% if c.phone %}{% set _ = cb.append(c.phone) %}{% endif %}
        {% if c.address %}{% set _ = cb.append(c.address) %}{% endif %}
        {% if c.site %}{% set _ = cb.append(c.site) %}{% endif %}
        {% for s in c.social %}{% if s.label %}{% set _ = cb.append(s.label) %}{% endif %}{% endfor %}
        {{ cb | br_join }}
      </div>
    </div>
    {% endif %}
  </div>
</div>
