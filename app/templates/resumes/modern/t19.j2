{# Modern Template 19 — Label Gutter · single column · label-margin editorial, bar skills
   Ported from block <!-- 19 --> / id="t19" of "Resume Templates Coded.dc.html".
   Locked spec: pure white, ink #1B1B22 body on Inter, plum #6B2A5A accent,
   Archivo 900 display. Name set across the full width in 58px caps over a 2px
   ink rule; title (plum, tracked) left / contact string right. A three-up stat
   band sits directly under the name. The body is a stack of gutter rows: a
   112px Archivo-900 plum label on the left, a hairline #D9D7DD across the top,
   wide measure on the right — Profile, Experience, Skills (2-col bar grid,
   track #E4E2E7 / fill #6B2A5A, level word as real text), Tooling, Education,
   and, when present, Languages and Certifications.

   Divergences from the supplied reference (image closed before design):
     1. Palette — ink #1B1B22 + plum #6B2A5A on white, not grey on grey.
     2. Type — Archivo 900 + Inter, not one geometric sans.
     3. Bars carry banded level words as real selectable text; a three-chip
        stat band sits directly under the name (reference has neither).
     4. Name is one data string set at 46px (not the reference 58px) so a long
        two-word name clears the gutter width without wrapping under the rule.
     5. Section gap 41->18 and gutter top-padding 18->13 to seat the shared
        sample (Profile+Experience+Skills+Tooling+Education+Languages+Certs is a
        denser stack than the reference's five rows). #}
{% import "_macros.j2" as m %}
{% set GUT = "width:124px; flex-shrink:0; font-family:Archivo,sans-serif; font-weight:900; font-size:11.5px; letter-spacing:1.4px; text-transform:uppercase; color:#6B2A5A;" %}
{% set ROW = "display:flex; gap:22px; border-top:1px solid #D9D7DD; padding-top:15px;" %}
<div class="tpl" style="box-sizing:border-box; width:850px; height:1100px; background:#ffffff; padding:52px 56px 44px; font-family:Inter,sans-serif; color:#1B1B22; display:flex; flex-direction:column; gap:22px;">

  <div>
    <div style="font-family:Archivo,sans-serif; font-weight:900; font-size:46px; line-height:1.0; letter-spacing:-1.6px; text-transform:uppercase;">{{ r.name }}</div>
    <div style="display:flex; justify-content:space-between; align-items:baseline; gap:24px; border-top:2px solid #1B1B22; margin-top:14px; padding-top:11px;">
      {% if r.title %}<span style="font-size:13.5px; letter-spacing:3.2px; text-transform:uppercase; color:#6B2A5A;">{{ r.title }}</span>{% endif %}
      {% set c = r.contact %}
      {% set bits = [] %}
      {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
      {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
      {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
      {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
      {% for s in c.social %}{% if s.label %}{% set _ = bits.append(s.label) %}{% endif %}{% endfor %}
      {% if bits %}<span style="font-size:11.5px; color:#54545E; text-align:end;">{{ bits | join(" · ") }}</span>{% endif %}
    </div>
  </div>

  {% if r.achievements %}
  <div style="display:grid; grid-auto-flow:column; grid-auto-columns:minmax(0,1fr); gap:20px;">
    {% for a in r.achievements %}
    {% if a.metric %}
    <div>
      <div style="font-family:Archivo,sans-serif; font-weight:900; font-size:28px; line-height:1; color:#6B2A5A;">{{ a.metric }}</div>
      <div style="font-size:9px; letter-spacing:1.3px; font-weight:700; text-transform:uppercase; color:#5A5A64; margin-top:6px;">{{ a.label }}</div>
    </div>
    {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  <div style="flex:1; min-width:0; display:flex; flex-direction:column; gap:21px;">

    {% if r.summary %}
    <div style="{{ ROW }}">
      <div style="{{ GUT }}">{{ t('Profile') }}</div>
      <div style="flex:1; min-width:0; font-size:12.5px; line-height:1.7; color:#2E2E38;">{{ r.summary }}</div>
    </div>
    {% endif %}

    {% if r.experience %}
    <div style="{{ ROW }}">
      <div style="{{ GUT }}">{{ t('Experience') }}</div>
      <div style="flex:1; min-width:0; display:flex; flex-direction:column; gap:16px;">
        {% for job in r.experience %}
        <div>
          <div style="display:flex; justify-content:space-between; align-items:baseline; gap:14px;">
            <span style="font-family:Archivo,sans-serif; font-weight:800; font-size:15px;">{{ job.role }}</span>
            {% if job.start or job.end %}<span style="font-size:11.5px; color:#63636D; white-space:nowrap;">{{ job.start }}{% if job.start and job.end %} — {% endif %}{{ job.end }}</span>{% endif %}
          </div>
          {% if job.company or job.location %}<div style="font-size:12.5px; color:#3E3E48; margin:3px 0 7px;">{{ job.company }}{% if job.company and job.location %} · {{ job.location }}{% elif job.location %}{{ job.location }}{% endif %}</div>{% endif %}
          {% if job.bullets %}
          <ul style="margin:0; padding-inline-start:16px; font-size:12.5px; line-height:1.6; color:#2E2E38;">
            {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
          </ul>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.skills %}
    <div style="{{ ROW }}">
      <div style="{{ GUT }}">{{ t('Skills') }}</div>
      <div style="flex:1; min-width:0; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:11px 34px;">
        {% for sk in r.skills %}
        {{ m.skill_bar(sk, {'stacked': True, 'track': '#E4E2E7', 'fill': '#6B2A5A',
           'track_h': 8, 'radius': '999px',
           'name_css': 'font-size:12.5px; font-weight:600; color:#1B1B22;',
           'label_css': 'font-size:10.5px; font-weight:400; color:#5A5A64; white-space:nowrap;'}) }}
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.tools %}
    <div style="{{ ROW }}">
      <div style="{{ GUT }}">{{ t('Tooling') }}</div>
      <div style="flex:1; min-width:0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px 24px; font-size:12.5px; color:#2E2E38;">
        {% for tool in r.tools %}<div>{{ tool }}</div>{% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.education %}
    <div style="{{ ROW }}">
      <div style="{{ GUT }}">{{ t('Education') }}</div>
      <div style="flex:1; min-width:0; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px 34px; font-size:12.5px; line-height:1.5;">
        {% for ed in r.education %}
        <div><b>{{ ed.degree }}</b>{% if ed.school or ed.end %}<br><span style="color:#5A5A64;">{{ ed.school }}{% if ed.school and ed.end %} · {% endif %}{{ ed.end }}</span>{% endif %}</div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.languages %}
    <div style="{{ ROW }}">
      <div style="{{ GUT }}">{{ t('Languages') }}</div>
      <div style="flex:1; min-width:0; font-size:12.5px; color:#2E2E38; line-height:1.6;">
        {% for l in r.languages %}{{ l.name }} <span style="color:#6B2A5A; font-weight:600;">{{ l.level }}</span>{% if not loop.last %} &nbsp;·&nbsp; {% endif %}{% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.recognition %}
    <div style="{{ ROW }}">
      <div style="{{ GUT }}">{{ t('Certifications') }}</div>
      <div style="flex:1; min-width:0; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px 34px; font-size:12.5px; line-height:1.5;">
        {% for rec in r.recognition %}
        <div><b>{{ rec.title }}</b>{% if rec.detail %}<br><span style="color:#5A5A64;">{{ rec.detail }}</span>{% endif %}</div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

  </div>
</div>
