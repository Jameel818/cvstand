{# Modern Template 22 — Vertical Rail Rings · body + side rail · bold type, circular skill rings
   Ported from block <!-- 22 --> / id="t22" of "Resume Templates Coded.dc.html".
   Locked spec: white page, ink #111, one accent orange #CB3500. A 215px left
   rail holds a single rotated "RESUME" set in Archivo 900 214px orange. The
   body: Archivo 900 56px name (reference 76px; scaled so a two-word name holds
   one line above the split) + tracked role; ABOUT ME under a 2px rule with a
   short summary; a four-chip stat band (1px #d8d8d8 rules, orange numerals);
   then a two-part row — left (flex 1.6) WORK EXPERIENCE and EDUCATION as
   node-dot timelines on a 2px ink rail, right (flex 1) right-aligned
   Address / Phone / Email blocks and a 2-up conic ring grid for SKILLS (ink
   dial on #d8d8d8 track, percent in a white hole as real text, name + level
   word beneath). Archivo display + Montserrat body.

   Divergences from the supplied reference:
     1. Palette — ink #111 + one orange #CB3500 on white, locked here.
     2. Type — Archivo 900 display + Montserrat body.
     3. Rings gain a level word as real text beneath the name; the reference's
        placeholder street address block becomes the generic contact blocks.
     4. The rotated "RESUME" rail is decorative DOM text (not resume data);
        it is clipped by the 215px rail.
     5. `.tpl` overflow is visible but the rail clips its own overflow; inner
        column gaps trimmed (26->20) to seat the shared sample. #}
{% import "_macros.j2" as m %}
{% set SECT = "font-family:Archivo,sans-serif; font-weight:900; font-size:24px; color:#111111; letter-spacing:1px;" %}
{% set RAIL = "display:flex; flex-direction:column; gap:16px; padding-inline-start:20px; border-inline-start:2px solid #111111;" %}
{% set NODE = "position:absolute; inset-inline-start:-30px; top:-2px; width:14px; height:14px; border-radius:50%; background:#ffffff; border:2px solid #111111; box-sizing:border-box;" %}
{% set CH = "font-family:Archivo,sans-serif; font-weight:900; font-size:22px; color:#111111; text-align:end;" %}
{% set CV = "font-size:11.5px; color:#444444; text-align:end; line-height:1.6; margin-top:6px; overflow-wrap:anywhere;" %}
<div class="tpl cv-sections-taj" style="box-sizing:border-box; width:850px; height:1100px; display:flex; background:#ffffff; overflow:hidden; font-family:Montserrat,sans-serif; color:#111111;">

  <div style="width:215px; flex-shrink:0; position:relative; overflow:hidden;">
    <div class="vrail" style="position:absolute; top:553.25px; inset-inline-start:118.5px; transform:translate(-50%,-50%) rotate(-90deg); width:1043.5px; display:flex; justify-content:flex-start; align-items:center; font-family:Archivo,Helvetica,sans-serif; font-weight:900; font-size:214px; color:#CB3500; -webkit-text-stroke:5px #CB3500; line-height:0.715; white-space:nowrap;">{% if r.dir == 'rtl' %}<span>{{ t('RESUME') }}</span>{% else %}<span style="margin-inline-end:9.71px;">R</span><span style="margin-inline-end:12.69px;">E</span><span style="margin-inline-end:7.69px;">S</span><span style="margin-inline-end:-1.06px;">U</span><span style="margin-inline-end:-1.81px;">M</span><span>E</span>{% endif %}</div>
  </div>

  <div style="flex:1; min-width:0; padding-block: 40px 40px; padding-inline: 12px 44px; display:flex; flex-direction:column; gap:20px;">
    <div style="display:flex; flex-direction:column; gap:6px;">
      <div class="cv-name" style="font-family:Archivo,sans-serif; font-weight:900; font-size:56px; color:#111111; letter-spacing:-2px; line-height:0.95; text-transform:uppercase;">{{ r.name }}</div>
      {% if r.title %}<div style="font-weight:800; font-size:19px; color:#111111; letter-spacing:3px; text-transform:uppercase;">{{ r.title }}</div>{% endif %}
    </div>

    {% if r.summary %}
    <div>
      <div style="display:flex; align-items:center; gap:16px; margin-bottom:10px;"><span class="cv-section" style="font-family:Archivo,sans-serif; font-weight:900; font-size:26px; color:#111111; letter-spacing:1px;">{{ t('ABOUT ME') }}</span><div style="flex:1; height:2px; background:#111111;"></div></div>
      <p style="font-size:12px; color:#333333; line-height:1.6; margin:0;">{{ r.summary }}</p>
    </div>
    {% endif %}

    {% if r.achievements %}
    <div style="display:grid; grid-auto-flow:column; grid-auto-columns:minmax(0,1fr); gap:12px; border-top:1px solid #d8d8d8; border-bottom:1px solid #d8d8d8; padding:14px 0;">
      {% for a in r.achievements %}
      {% if a.metric %}
      <div style="text-align:center;">
        <div style="font-family:Archivo,sans-serif; font-weight:900; font-size:25px; line-height:1; color:#CB3500;">{{ a.metric }}</div>
        <div style="font-size:9px; letter-spacing:1px; font-weight:700; text-transform:uppercase; color:#666666; margin-top:5px;">{{ a.label }}</div>
      </div>
      {% endif %}
      {% endfor %}
    </div>
    {% endif %}

    <div style="display:flex; gap:34px; flex:1; min-height:0;">
      <div style="flex:1.6; min-width:0; display:flex; flex-direction:column; gap:24px;">
        {% if r.experience %}
        <div>
          <div style="display:flex; align-items:center; gap:14px; margin-bottom:14px;"><span class="cv-section" style="{{ SECT }}">{{ t('WORK EXPERIENCE') }}</span><div style="flex:1; height:2px; background:#111111;"></div></div>
          <div style="{{ RAIL }}">
            {% for job in r.experience %}
            <div style="position:relative;">
              <span style="{{ NODE }}"></span>
              <div style="font-weight:800; font-size:14px; color:#111111;">{{ job.role }}{% if job.start or job.end %} ({{ job.start }}{% if job.start and job.end %}–{% endif %}{{ job.end }}){% endif %}</div>
              {% if job.company or job.location %}<div style="font-size:11.5px; color:#CB3500; margin-top:2px;">{{ job.company }}{% if job.company and job.location %} · {{ job.location }}{% elif job.location %}{{ job.location }}{% endif %}</div>{% endif %}
              {% if job.bullets %}<p style="font-size:11.5px; color:#444444; line-height:1.55; margin:4px 0 0;">{{ job.bullets | join(" ") }}</p>{% endif %}
            </div>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        {% if r.education %}
        <div>
          <div style="display:flex; align-items:center; gap:14px; margin-bottom:14px;"><span class="cv-section" style="{{ SECT }}">{{ t('EDUCATION') }}</span><div style="flex:1; height:2px; background:#111111;"></div></div>
          <div style="{{ RAIL }}">
            {% for ed in r.education %}
            <div style="position:relative;">
              <span style="{{ NODE }}"></span>
              <div style="font-weight:800; font-size:14px; color:#111111;">{{ ed.degree }}{% if ed.start or ed.end %} ({{ ed.start }}{% if ed.start and ed.end %}–{% endif %}{{ ed.end }}){% endif %}</div>
              {% if ed.school %}<div style="font-size:11.5px; color:#CB3500; margin-top:2px;">{{ ed.school }}</div>{% endif %}
              {% if ed.bullets %}<p style="font-size:11.5px; color:#444444; line-height:1.5; margin:4px 0 0;">{{ ed.bullets | join(" ") }}</p>{% endif %}
            </div>
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </div>

      <div style="flex:1; min-width:0; display:flex; flex-direction:column; gap:18px;">
        {% set c = r.contact %}
        {% if c.address %}<div><div style="{{ CH }}">{{ t('Address') }}</div><div style="{{ CV }}">{{ c.address }}</div></div>{% endif %}
        {% if c.phone %}<div><div style="{{ CH }}">{{ t('Phone') }}</div><div style="{{ CV }}">{{ c.phone }}</div></div>{% endif %}
        {% if c.email %}<div><div style="{{ CH }}">{{ t('Email') }}</div><div style="{{ CV }}">{{ c.email }}</div></div>{% endif %}
        {% if c.site %}<div><div style="{{ CH }}">{{ t('Web') }}</div><div style="{{ CV }}">{{ c.site }}</div></div>{% endif %}

        {% if r.skills %}
        <div>
          <div class="cv-section" style="{{ CH }} margin-bottom:14px;">{{ t('Skills') }}</div>
          <div style="display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); justify-items:center; align-items:start; gap:16px 4px;">
            {% for sk in r.skills %}
            {{ m.skill_ring(sk, {'size': 66, 'hole': 46, 'ring': '#111111', 'track': '#d8d8d8',
               'ink': '#111111', 'pct_size': 13,
               'name_css': 'font-size:9.5px; font-weight:800; color:#111111; text-align:center; line-height:1.25;',
               'level_css': 'font-size:8.5px; font-weight:700; color:#5f5f5f; text-align:center;'}) }}
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
