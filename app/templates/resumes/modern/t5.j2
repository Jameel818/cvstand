{# Modern Template 5 — Rounded Dark · two-column · pill headers, coral slider skills
   Ported from block <!-- 5 --> / id="t5" of "Resume Templates Coded.dc.html".
   Locked spec: #F2F2F2 page frame (24px), navy #003366 sidebar with white text,
   pill section headers (white pill = #1a1a1a text; dark pill = #1a1a1a bg / white
   text, border-radius 14–16px), coral #F26A5F for the stat metrics and the skill
   sliders (track #F4D0CC, 18px white knob with a 3px coral ring). Archivo 900
   52px name; grey #E6E8EC rounded education cards; a dotted timeline rail on the
   experience column. Skill = name + percent/level as real selectable text beside
   the slider.

   Divergences from the supplied reference:
     1. Palette — navy #003366 sidebar + coral #F26A5F accent on an #F2F2F2 frame;
        colours shifted from the reference for copyright.
     2. Type — Archivo only for the display name/stat numerals; system sans body.
     3. Structure — the empty "Projects" pill is dropped (no data field);
        "Certifications" renders only when r.recognition is present; Tools move to
        a sidebar "SOFTWARE" pill (the reference's empty navy space) rather than a
        right-column pill, which balances the columns and clears the overflow.
     4. Skill sliders keep the knob but every skill states name AND percent/level
        as real text; the 3-col skill grid is closed with filler cells so a
        non-multiple-of-3 count stays rectangular.
     5. Right-column gap 22->16 and experience gap 16->12 to seat the shared dense
        sample (3 roles, 5 skills) on one fixed 1100px page.
     6. Decorative contact glyphs (☎ ✉ ◉) dropped — plain text lines. #}
{% set WHITE_PILL = "background:#ffffff; color:#1a1a1a; font-weight:800; font-size:16px; padding:10px 22px; border-radius:14px;" %}
{% set DARK_PILL_SM = "background:#1a1a1a; color:#ffffff; font-weight:800; font-size:16px; padding:10px 22px; border-radius:14px; letter-spacing:0.5px;" %}
{% set DARK_PILL = "background:#1a1a1a; color:#ffffff; font-weight:800; font-size:15px; padding:12px 22px; border-radius:16px; letter-spacing:1px;" %}
<div class="tpl" style="box-sizing:border-box; width:850px; height:1100px; padding:24px; background:#f2f2f2; display:flex; gap:26px; font-family:'Open Sans',sans-serif;">

  <div style="width:280px; flex-shrink:0; background:#003366; padding:32px 26px; display:flex; flex-direction:column; gap:20px; color:#ffffff;">

    <div style="width:150px; height:150px; flex-shrink:0; aspect-ratio:1; border-radius:50%; background:#d6dde3; align-self:center; overflow:hidden;">
      {% if r.photo_url %}<img src="{{ r.photo_url }}" alt="" style="width:100%; height:100%; object-fit:cover; display:block;">{% endif %}
    </div>

    {% set c = r.contact %}{% set cl = [] %}
    {% if c.phone %}{% set _ = cl.append(c.phone) %}{% endif %}
    {% if c.email %}{% set _ = cl.append(c.email) %}{% endif %}
    {% if c.address %}{% set _ = cl.append(c.address) %}{% endif %}
    {% if c.site %}{% set _ = cl.append(c.site) %}{% endif %}
    {% for s in c.social %}{% if s.label %}{% set _ = cl.append(s.label) %}{% endif %}{% endfor %}
    {% if cl %}
    <div style="{{ WHITE_PILL }}">{{ t('Contact') }}</div>
    <div style="font-size:12.5px; line-height:1.7; padding-inline-start:6px; overflow-wrap:anywhere;">{{ cl | br_join }}</div>
    {% endif %}

    {% if r.summary %}
    <div style="{{ WHITE_PILL }}">{{ t('SUMMARY') }}</div>
    <p style="font-size:12px; line-height:1.6; margin:0 6px;">{{ r.summary }}</p>
    {% endif %}

    {% if r.education %}
    <div style="{{ DARK_PILL_SM }}">{{ t('EDUCATION') }}</div>
    <div style="display:flex; flex-direction:column; gap:10px;">
      {% for ed in r.education %}
      <div style="background:#e6e8ec; color:#1a1a1a; border-radius:12px; padding:12px 14px; display:flex; gap:12px; font-size:11.5px;">
        {% if ed.start or ed.end %}<div style="font-weight:600; line-height:1.4; flex-shrink:0;">{{ ed.start }}{% if ed.start and ed.end %}<br>—<br>{% endif %}{{ ed.end }}</div>{% endif %}
        <div><b>{{ ed.degree }}</b>{% if ed.school %}<br><span style="color:#666;">{{ ed.school }}</span>{% endif %}{% if ed.gpa %}<br><span style="color:#666;">{{ t('GPA') }} {{ ed.gpa }}</span>{% endif %}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if r.tools %}
    <div style="{{ DARK_PILL_SM }}">{{ t('SOFTWARE') }}</div>
    <div style="font-size:12px; line-height:1.7; padding-inline-start:6px; overflow-wrap:anywhere;">{{ r.tools | br_join }}</div>
    {% endif %}

    {% if r.languages %}
    <div style="{{ DARK_PILL_SM }}">{{ t('LANGUAGES') }}</div>
    <div style="font-size:12px; line-height:1.7; padding-inline-start:6px;">{% for l in r.languages %}{{ l.name }} — {{ l.level }}{% if not loop.last %}<br>{% endif %}{% endfor %}</div>
    {% endif %}

  </div>

  <div style="flex:1; min-width:0; display:flex; flex-direction:column; gap:16px;">

    <div style="padding:8px 6px 0;">
      {% set nm = r.name.split(" ", 1) %}
      <div style="font-family:Archivo,sans-serif; font-weight:900; font-size:52px; color:#1a1a1a; letter-spacing:-1px; line-height:0.95; text-transform:uppercase;">{{ nm[0] }}{% if nm|length > 1 %}<br>{{ nm[1] }}{% endif %}</div>
      {% if r.title %}<div style="font-size:18px; color:#333; margin-top:8px; letter-spacing:1px;">{{ r.title }}</div>{% endif %}
    </div>

    {% if r.achievements %}
    <div style="display:grid; grid-auto-flow:column; grid-auto-columns:minmax(0,1fr); gap:12px; border-top:1px solid #d9d9d9; border-bottom:1px solid #d9d9d9; padding:14px 0;">
      {% for a in r.achievements %}
      <div style="text-align:center;">
        <div style="font-family:Archivo,sans-serif; font-weight:900; font-size:26px; line-height:1; color:#f26a5f;">{{ a.metric }}</div>
        <div style="font-size:9px; letter-spacing:1px; font-weight:700; text-transform:uppercase; color:#555555; margin-top:5px;">{{ a.label }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if r.experience %}
    <div style="{{ DARK_PILL }}">{{ t('PROFESSIONAL EXPERIENCE') }}</div>
    <div style="padding:0 6px; display:flex; flex-direction:column; gap:12px;">
      {% for job in r.experience %}
      <div style="display:flex; gap:16px;">
        <div style="font-size:11.5px; color:#333; flex-shrink:0; width:52px; text-align:end; line-height:1.4;">{{ job.start }}{% if job.start and job.end %}<br>—<br>{% endif %}{{ job.end }}</div>
        <div style="position:relative; padding-inline-start:16px; border-inline-start:2px solid #1a1a1a; flex:1; min-width:0;">
          <span style="position:absolute; inset-inline-start:-6px; top:0; width:10px; height:10px; background:#1a1a1a; border-radius:50%;"></span>
          <div style="font-weight:700; font-size:14px;">{{ job.role }}</div>
          {% if job.company or job.location %}<div style="font-size:12px; color:#555; margin-bottom:4px;">{{ job.company }}{% if job.company and job.location %} · {% endif %}{{ job.location }}</div>{% endif %}
          {% if job.bullets %}
          <ul style="margin:0; padding-inline-start:16px; font-size:11.5px; color:#333; line-height:1.5;">
            {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
          </ul>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if r.skills %}
    <div style="{{ DARK_PILL }}">{{ t('CREATIVE & TECHNICAL SKILLS') }}</div>
    <div style="display:grid; grid-template-columns:repeat(3,1fr); padding:6px 4px 0; border-top:1px solid #d9d9d9; border-inline-start:1px solid #d9d9d9;">
      {% for sk in r.skills %}
      {% set _pc = sk.get('percent') %}
      {% set pct = _pc if _pc is not none else (sk.dots / sk.dot_total * 100) | round | int %}
      <div style="padding:14px 18px; border-inline-end:1px solid #d9d9d9; border-bottom:1px solid #d9d9d9;">
        <div style="font-size:13px; color:#1a1a1a; font-weight:500; margin-bottom:16px; line-height:1.3; min-height:34px;">{{ sk.name }}</div>
        <div style="display:flex; align-items:center; gap:10px; height:18px;">
          {% if sk.level or _pc is not none %}
          <div style="flex:1; position:relative; height:4px; background:#f4d0cc; border-radius:2px;">
            <div style="width:{{ pct }}%; height:100%; background:#f26a5f; border-radius:2px;"></div>
            <div style="position:absolute; inset-inline-start:calc({{ pct }}% - 9px); top:50%; transform:translateY(-50%); width:18px; height:18px; border-radius:50%; background:#ffffff; border:3px solid #f26a5f; box-sizing:border-box;"></div>
          </div>
          {% endif %}
          <div style="font-size:12px; color:#1a1a1a; font-weight:700; min-width:52px; text-align:end;">{{ (_pc ~ '%') if _pc is not none else sk.level }}</div>
        </div>
      </div>
      {% endfor %}
      {% for i in range((3 - (r.skills | length) % 3) % 3) %}
      <div style="border-inline-end:1px solid #d9d9d9; border-bottom:1px solid #d9d9d9;"></div>
      {% endfor %}
    </div>
    {% endif %}

    {% if r.recognition %}
    <div style="{{ DARK_PILL }}">{{ t('CERTIFICATIONS') }}</div>
    <div style="padding:0 6px; display:flex; flex-direction:column; gap:6px; font-size:12px; color:#333;">
      {% for rec in r.recognition %}
      <div><b>{{ rec.title }}</b>{% if rec.detail %} — {{ rec.detail }}{% endif %}</div>
      {% endfor %}
    </div>
    {% endif %}

  </div>
</div>
