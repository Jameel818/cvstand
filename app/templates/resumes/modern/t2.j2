{# Modern Template 2 — Navy & Gold · navy sidebar + gold band · skill bars
   Ported from block <!-- 2 --> / id="t2" of "Resume Templates Coded.dc.html".
   Locked spec: navy #002366, gold #FFD700, track #E0E0E0, Archivo throughout,
   skill bars with the percent as real text, four-chip metric band under contact.
   NOTE: reference keeps sidebar & main body on `justify-content:space-between`
   (locked visual). Experience bullets render as one paragraph, per the reference. #}
{% import "_macros.j2" as m %}
{% macro side_head(label) %}
  <div style="display:flex; align-items:center; gap:12px; margin-bottom:10px;">
    <span class="cv-section" style="font-family:Archivo,sans-serif; font-weight:700; font-size:16.5px; color:#ffffff; letter-spacing:3px;">{{ label }}</span>
    <div style="flex:1; height:1px; background:#FFD700;"></div>
  </div>
{% endmacro %}
{% macro main_head(label) %}
  <div style="display:flex; align-items:center; gap:14px; margin-bottom:16px;">
    <span class="cv-section" style="font-family:Archivo,sans-serif; font-weight:700; font-size:19px; color:#002366; letter-spacing:3px;">{{ label }}</span>
    <div style="flex:1; height:1px; background:#FFD700;"></div>
  </div>
{% endmacro %}
<div class="tpl" style="box-sizing:border-box; width:850px; height:1100px; display:flex; background:#ffffff; font-family:Archivo,sans-serif;">

  <div style="width:298px; flex-shrink:0; background:#002366; padding:34px 28px 30px; display:flex; flex-direction:column; justify-content:space-between; gap:26px; box-sizing:border-box;">
    <div style="display:flex; justify-content:center;">
      {% if r.photo_url %}
      <img src="{{ r.photo_url }}" alt="" style="width:150px; height:150px; flex-shrink:0; aspect-ratio:1; border-radius:50%; border:5px solid #FFD700; object-fit:cover; box-sizing:border-box;">
      {% else %}
      <div style="width:150px; height:150px; flex-shrink:0; aspect-ratio:1; border-radius:50%; border:5px solid #FFD700; background:#E0E0E0; display:flex; align-items:center; justify-content:center; text-align:center; font-size:10px; color:#5b6270; letter-spacing:0.5px; padding:14px; box-sizing:border-box;">{{ t('PORTRAIT<br>PLACEHOLDER') }}</div>
      {% endif %}
    </div>

    {% if r.summary %}
    <div>
      {{ side_head(t("ABOUT ME")) }}
      <p style="font-size:12.5px; color:#dfe3ea; line-height:1.65; margin:0; text-align:justify;">{{ r.summary }}</p>
    </div>
    {% endif %}

    {% if r.education %}
    <div>
      {{ side_head(t("EDUCATION")) }}
      <div style="display:flex; flex-direction:column; gap:14px;">
        {% for ed in r.education %}
        <div>
          <div style="font-family:Archivo,sans-serif; font-weight:700; font-size:13px; color:#ffffff; line-height:1.4;">{{ ed.degree }}</div>
          {% if ed.school %}<div style="font-size:12px; color:#c8cfdb; line-height:1.5;">{{ ed.school }}</div>{% endif %}
          {% if ed.start or ed.end %}<div style="font-size:12px; color:#FFD700; line-height:1.5;">{{ ed.start }}{% if ed.start and ed.end %} – {% endif %}{{ ed.end }}</div>{% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.skills %}
    <div>
      {{ side_head(t("SKILLS")) }}
      <div style="display:flex; flex-direction:column; gap:11px;">
        {% for sk in r.skills %}
        {{ m.skill_bar(sk, {'track': '#E0E0E0', 'fill': '#FFD700', 'name_css': 'flex:1; font-size:12px; color:#ffffff; white-space:nowrap;', 'label_css': 'width:26px; font-size:10px; color:#FFD700; text-align:end; flex-shrink:0;'}) }}
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.languages %}
    <div>
      {{ side_head(t("LANGUAGE")) }}
      <div style="display:flex; flex-direction:column; gap:6px;">
        {% for l in r.languages %}
        <div style="display:flex; justify-content:space-between; font-size:12px; color:#ffffff;"><span>{{ l.name }}</span><span style="color:#FFD700;">{{ l.level }}</span></div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.recognition %}
    <div>
      {{ side_head(t("CERTIFICATIONS")) }}
      <div style="display:flex; flex-direction:column; gap:10px;">
        {% for rec in r.recognition %}
        <div>
          <div style="font-family:Archivo,sans-serif; font-weight:700; font-size:12.5px; color:#ffffff; line-height:1.4;">{{ rec.title }}</div>
          {% if rec.detail %}<div style="font-size:12px; color:#FFD700; line-height:1.5;">{{ rec.detail }}</div>{% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>

  <div style="flex:1; display:flex; flex-direction:column; min-width:0;">
    <div style="background:#FFD700; padding:26px 40px; margin-top:34px;">
      <div class="cv-name" style="font-family:Archivo,sans-serif; font-weight:900; font-size:58px; color:#002366; letter-spacing:1px; line-height:1; text-transform:uppercase;">{{ r.name }}</div>
      {% if r.title %}<div style="font-family:Archivo,sans-serif; font-weight:400; font-size:17px; color:#002366; letter-spacing:4px; margin-top:8px;">{{ r.title }}</div>{% endif %}
    </div>

    {# `justify-content:space-between` on a FIXED 1100px column distributes all
       leftover height between the children, so it only looks like the reference
       when the content happens to fill the page — which it did in the reference
       image and does not for a real résumé. Measured on the shipped sample: a
       declared 22px gap rendering as 157px twice, 270px of void between the
       contact block, the stat band and EXPERIENCE. Stacking from the top keeps
       the reference's rhythm at every content volume and puts the slack at the
       bottom, where a short CV belongs. #}
    <div style="padding:26px 40px 34px; display:flex; flex-direction:column; gap:22px; flex:1; min-height:0;">
      {% set c = r.contact %}
      {% if c.phone or c.site or c.email or c.address %}
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px 20px;">
        {% if c.phone %}<div><div style="font-size:10px; color:#667085; letter-spacing:1.5px; font-weight:600;">{{ t('PHONE') }}</div><div style="font-size:12.5px; color:#20242e;">{{ c.phone }}</div></div>{% endif %}
        {% if c.site %}<div><div style="font-size:10px; color:#667085; letter-spacing:1.5px; font-weight:600;">{{ t('WEBSITE') }}</div><div style="font-size:12.5px; color:#20242e;">{{ c.site }}</div></div>{% endif %}
        {% if c.email %}<div><div style="font-size:10px; color:#667085; letter-spacing:1.5px; font-weight:600;">{{ t('EMAIL') }}</div><div style="font-size:12.5px; color:#20242e;">{{ c.email }}</div></div>{% endif %}
        {% if c.address %}<div><div style="font-size:10px; color:#667085; letter-spacing:1.5px; font-weight:600;">{{ t('LOCATION') }}</div><div style="font-size:12.5px; color:#20242e;">{{ c.address }}</div></div>{% endif %}
      </div>
      {% endif %}

      {% if r.achievements %}
      <div style="display:grid; grid-auto-flow:column; grid-auto-columns:minmax(0,1fr); gap:12px; border-top:1px solid #E0E0E0; border-bottom:1px solid #E0E0E0; padding:16px 0;">
        {% for a in r.achievements %}
        <div style="text-align:center;">
          <div style="font-family:Archivo,sans-serif; font-weight:900; font-size:26px; color:#002366; line-height:1;">{{ a.metric }}</div>
          <div style="font-size:10px; color:#667085; letter-spacing:1px; font-weight:600; margin-top:5px;">{{ a.label }}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if r.experience %}
      <div>
        {{ main_head(t("EXPERIENCE")) }}
        <div style="position:relative; padding-inline-start:26px; margin-inline-start:6px;">
          <span style="position:absolute; inset-inline-start:0; top:8px; bottom:8px; width:2px; background:#FFD700;"></span>
          <div style="display:flex; flex-direction:column; gap:18px;">
            {% for job in r.experience %}
            <div style="position:relative;">
              <span style="position:absolute; inset-inline-start:-31px; top:2px; width:12px; height:12px; border-radius:50%; background:#ffffff; border:2px solid #FFD700; box-sizing:border-box;"></span>
              <div style="display:flex; justify-content:space-between; align-items:baseline; gap:12px;">
                <span style="font-family:Archivo,sans-serif; font-weight:700; font-size:15px; color:#002366;">{{ job.role }}</span>
                {% if job.start or job.end %}<span style="font-size:12px; color:#667085; font-style:italic; white-space:nowrap;">{{ job.start }}{% if job.start and job.end %} – {% endif %}{{ job.end }}</span>{% endif %}
              </div>
              {% if job.company or job.location %}<div style="font-size:12px; color:#4a5160; margin-top:3px;">{{ job.company }}{% if job.company and job.location %} · {% endif %}{{ job.location }}</div>{% endif %}
              {% if job.bullets %}<p style="font-size:12.5px; color:#333a47; line-height:1.6; margin:6px 0 0;">{{ job.bullets | join(" ") }}</p>{% endif %}
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
      {% endif %}

      {% if r.references %}
      <div>
        {{ main_head(t("REFERENCES")) }}
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
          {% for ref in r.references %}
          <div>
            <div style="font-family:Archivo,sans-serif; font-weight:700; font-size:14px; color:#002366;">{{ ref.name }}</div>
            {% if ref.title %}<div style="font-size:12px; color:#4a5160; margin-top:2px;">{{ ref.title }}</div>{% endif %}
            {% if ref.phone or ref.email %}<div style="font-size:12px; color:#333a47; margin-top:4px; line-height:1.5;">{{ ref.phone }}{% if ref.phone and ref.email %}<br>{% endif %}{{ ref.email }}</div>{% endif %}
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</div>
