{# Modern Template 11 — Colour Header Rail · two-column (absolute) · dot-grid levels
   Ported from block <!-- 11 --> / id="t11" of "Resume Templates Coded.dc.html".
   Locked spec: navy #0F1B2B left rail (photo block #2C3846 at its head), a
   #FFD700 yellow header block top-right carrying the name / role / stat row /
   contact on ink #08211C; white experience column below with #FFD700 marker
   bars on each entry. Archivo 900 for the 50px name, stat numerals and rail
   section labels; Open Sans body. Rail dot-grid: filled #FFD700 / empty 1px
   #46586B, name AND level word as real text.

   Divergences from ref D (dark rail + colour header block):
     1. Palette — navy #0F1B2B + yellow #FFD700, not black/orange.
     2. Type — Archivo 900 display + Open Sans body.
     3. Flat skill list becomes dot-grid rows with the level word as real text;
        the yellow header block carries a quantified stat row.
     4. Recognition + Tools have no place in the reference; when present they
        render in the experience column after Experience. Language stays pinned
        to the foot of the rail (margin-top:auto).
     5. `.tpl` is overflow:hidden with absolutely-placed panels, so the `.tpl`
        scrollHeight cannot see a clip — verified by measuring the rail and body
        panels + screenshot. Rail gap 20->13 and body gap 20->15 to fit the
        shared sample. #}
{% set RAIL_H = "font-family:Archivo,sans-serif; font-weight:900; font-size:20px; letter-spacing:1px; text-transform:uppercase; color:#ffffff; margin-bottom:10px;" %}
<div class="tpl" style="box-sizing:border-box; position:relative; width:850px; height:1100px; background:#ffffff; overflow:hidden; font-family:'Open Sans',sans-serif; color:#22262E;">
  <div style="position:absolute; inset-inline-start:0; top:0; width:300px; bottom:0; background:#0F1B2B;"></div>
  <div style="position:absolute; inset-inline-start:0; top:0; width:300px; height:300px; background:#2C3846; overflow:hidden;">
    {% if r.photo_url %}<img src="{{ r.photo_url }}" alt="" style="width:100%; height:100%; object-fit:cover; display:block;">{% endif %}
  </div>
  <div style="position:absolute; inset-inline-start:300px; top:0; inset-inline-end:0; height:300px; background:#FFD700;"></div>

  <div style="box-sizing:border-box; position:absolute; inset-inline-start:300px; top:0; inset-inline-end:0; height:300px; padding-block: 38px 0; padding-inline: 38px 40px; color:#08211C;">
    <div class="cv-name" style="font-family:Archivo,sans-serif; font-weight:900; font-size:48px; line-height:1.0; letter-spacing:-1.2px; text-transform:uppercase;">{{ r.name }}</div>
    {% if r.title %}<div style="font-size:15px; letter-spacing:4px; text-transform:uppercase; margin-top:8px;">{{ r.title }}</div>{% endif %}
    <div style="height:1px; background:rgba(8,33,28,0.32); margin:14px 0 12px;"></div>
    {% if r.achievements %}
    <div style="display:grid; grid-auto-flow:column; grid-auto-columns:minmax(0,1fr); gap:12px;">
      {% for a in r.achievements %}
      <div><div style="font-family:Archivo,sans-serif; font-weight:900; font-size:22px;">{{ a.metric }}</div><div style="font-size:8.5px; letter-spacing:1px; font-weight:700; text-transform:uppercase; margin-top:3px;">{{ a.label }}</div></div>
      {% endfor %}
    </div>
    {% endif %}
    {% set c = r.contact %}{% set bits = [] %}
    {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
    {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
    {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
    {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
    {% for s in c.social %}{% if s.label %}{% set _ = bits.append(s.label) %}{% endif %}{% endfor %}
    {% if bits %}<div style="font-size:11px; line-height:1.65; margin-top:12px;">{{ bits | join(" · ") }}</div>{% endif %}
  </div>

  <div style="box-sizing:border-box; position:absolute; inset-inline-start:0; top:300px; width:300px; bottom:0; padding-block: 24px 24px; padding-inline: 32px 28px; color:#DCE3EC; display:flex; flex-direction:column; gap:13px;">
    {% if r.summary %}
    <div style="font-size:11.5px; line-height:1.65; font-style:italic; color:#C3CEDB;">{{ r.summary }}</div>
    <div style="height:2px; width:60px; background:#FFD700; flex-shrink:0;"></div>
    {% endif %}

    {% if r.skills %}
    <div>
      <div class="cv-section" style="{{ RAIL_H }}">{{ t('Skills') }}</div>
      <div style="display:flex; flex-direction:column; gap:8px;">
        {% for sk in r.skills %}
        <div>
          <div style="display:flex; justify-content:space-between; font-size:12px;"><span style="font-weight:600; color:#ffffff;">{{ sk.name }}</span><span style="color:#8FA1B4; font-size:10.5px;">{{ sk.level }}</span></div>
          {% if sk.level %}
          <div style="display:flex; gap:5px; margin-top:4px;">
            {% for i in range(sk.dot_total) %}
            {% if i < sk.dots %}
            <span style="width:9px; height:9px; border-radius:50%; background:#FFD700;"></span>
            {% else %}
            <span style="width:9px; height:9px; border-radius:50%; border:1px solid #46586B; box-sizing:border-box;"></span>
            {% endif %}
            {% endfor %}
          </div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.education %}
    <div>
      <div class="cv-section" style="{{ RAIL_H }}">{{ t('Education') }}</div>
      <div style="font-size:11.5px; line-height:1.6; color:#C3CEDB;">
        {% for ed in r.education %}
        <div style="{% if not loop.first %}margin-top:8px;{% endif %}"><b style="color:#ffffff;">{{ ed.degree }}</b>{% if ed.school or ed.end %}<br>{{ ed.school }}{% if ed.school and ed.end %} · {% endif %}{{ ed.end }}{% endif %}</div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.languages %}
    <div style="margin-top:auto;">
      <div class="cv-section" style="{{ RAIL_H }} margin-bottom:8px;">{{ t('Language') }}</div>
      <div style="font-size:11.5px; line-height:1.6; color:#C3CEDB;">{% for l in r.languages %}{{ l.name }} — {{ l.level }}{% if not loop.last %}<br>{% endif %}{% endfor %}</div>
    </div>
    {% endif %}
  </div>

  <div style="box-sizing:border-box; position:absolute; inset-inline-start:300px; top:300px; inset-inline-end:0; bottom:0; padding-block: 28px 28px; padding-inline: 38px 44px; display:flex; flex-direction:column; gap:15px;">
    {% if r.experience %}
    <div>
      <div class="cv-section" style="font-family:Archivo,sans-serif; font-weight:900; font-size:26px; letter-spacing:1px; text-transform:uppercase; margin-bottom:14px;">{{ t('Experience') }}</div>
      <div style="display:flex; flex-direction:column; gap:14px;">
        {% for job in r.experience %}
        <div style="border-inline-start:2px solid #FFD700; padding-inline-start:18px;">
          <div style="font-weight:700; font-size:14px; letter-spacing:0.4px; text-transform:uppercase;">{{ job.role }}</div>
          {% if job.company or job.location or job.start or job.end %}
          <div style="font-size:12px; color:#5E6875; margin:3px 0 6px;">{{ job.company }}{% if job.company and job.location %} · {{ job.location }}{% elif job.location %}{{ job.location }}{% endif %}{% if (job.company or job.location) and (job.start or job.end) %} · {% endif %}{{ job.start }}{% if job.start and job.end %} – {% endif %}{{ job.end }}</div>
          {% endif %}
          {% if job.bullets %}
          <ul style="margin:0; padding-inline-start:16px; font-size:12px; line-height:1.55; color:#3A414B;">
            {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
          </ul>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.recognition %}
    <div>
      <div class="cv-section" style="font-family:Archivo,sans-serif; font-weight:900; font-size:22px; letter-spacing:1px; text-transform:uppercase; margin-bottom:10px;">{{ t('Recognition') }}</div>
      <div style="display:flex; flex-direction:column; gap:4px; font-size:12px; color:#3A414B;">
        {% for rec in r.recognition %}<div><b style="color:#22262E;">{{ rec.title }}</b>{% if rec.detail %} — {{ rec.detail }}{% endif %}</div>{% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.tools %}
    <div>
      <div class="cv-section" style="font-family:Archivo,sans-serif; font-weight:900; font-size:22px; letter-spacing:1px; text-transform:uppercase; margin-bottom:8px;">{{ t('Tools') }}</div>
      <div style="font-size:12px; line-height:1.6; color:#3A414B;">{{ r.tools | join(" · ") }}</div>
    </div>
    {% endif %}
  </div>
</div>
