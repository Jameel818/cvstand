{# Modern Template 23 — Spine Timeline · grey rail + black spine · software engineering
   Ported from block <!-- 23 --> / id="t23" of "Resume Templates Coded.dc.html".
   Locked spec: ink #151517, grey rail #EFEFEF, track #DCDCDC, Inter body +
   Archivo heads, skill bars with the level word as real text, a pill role tag,
   a three-chip metric band.
   NOTE: the reference positions three decorative spine dots at fixed y
   (220 / 520 / 820) — kept as-is; they are ornamental, not entry markers. #}
{% import "_macros.j2" as m %}
{% set SH = "font-family:Archivo,sans-serif; font-weight:900; font-size:22px; letter-spacing:1px; text-transform:uppercase;" %}
{% set name_parts = r.name.split(" ", 1) %}
<div class="tpl cv-sections-taj" style="box-sizing:border-box; position:relative; width:850px; height:1100px; background:#ffffff; overflow:hidden; font-family:Inter,sans-serif; color:#151517;">
  <div style="position:absolute; inset-inline-start:0; top:0; width:330px; bottom:0; background:#EFEFEF;"></div>
  <div style="position:absolute; inset-inline-start:330px; top:0; width:2px; bottom:0; background:#151517;"></div>
  <div style="position:absolute; inset-inline-start:319px; top:220px; width:24px; height:24px; border-radius:50%; background:#151517;"></div>
  <div style="position:absolute; inset-inline-start:319px; top:520px; width:24px; height:24px; border-radius:50%; background:#151517;"></div>
  <div style="position:absolute; inset-inline-start:319px; top:820px; width:24px; height:24px; border-radius:50%; background:#151517;"></div>

  <div style="box-sizing:border-box; position:absolute; inset-inline-start:0; top:0; width:330px; bottom:0; padding-block: 56px 34px; padding-inline: 30px 24px; display:flex; flex-direction:column; gap:28px;">
    <div class="cv-name" style="font-family:Archivo,sans-serif; font-weight:900; font-size:40px; line-height:1.02; text-transform:uppercase; letter-spacing:-0.5px;">{{ name_parts[0] }}{% if name_parts|length > 1 %}<br>{{ name_parts[1] }}{% endif %}</div>

    {% set c = r.contact %}{% set bits = [] %}
    {% if c.email %}{% set _ = bits.append(c.email) %}{% endif %}
    {% if c.site %}{% set _ = bits.append(c.site) %}{% endif %}
    {% if c.phone %}{% set _ = bits.append(c.phone) %}{% endif %}
    {% if c.address %}{% set _ = bits.append(c.address) %}{% endif %}
    {% if bits %}
    <div>
      <div class="cv-section" style="{{ SH }} margin-bottom:10px;">{{ t('Contact') }}</div>
      <div style="font-size:12px; line-height:1.85; color:#3C3C40;">{{ bits | br_join }}</div>
    </div>
    {% endif %}

    {% if r.summary %}
    <div>
      <div class="cv-section" style="{{ SH }} margin-bottom:10px;">{{ t('Summary') }}</div>
      <div style="font-size:12px; line-height:1.65; color:#3C3C40;">{{ r.summary }}</div>
    </div>
    {% endif %}

    {% if r.skills %}
    <div>
      <div class="cv-section" style="{{ SH }} margin-bottom:12px;">{{ t('Skills') }}</div>
      <div style="display:flex; flex-direction:column; gap:10px;">
        {% for sk in r.skills %}
        {{ m.skill_bar(sk, {'stacked': true, 'track': '#DCDCDC', 'fill': '#151517', 'track_h': 7, 'radius': '999px',
             'name_css': 'font-size:11.5px; font-weight:600; color:#151517;',
             'label_css': 'color:#6B6B70; font-size:10.5px; font-weight:400;'}) }}
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if r.education %}
    <div style="margin-top:auto;">
      <div class="cv-section" style="{{ SH }} margin-bottom:8px;">{{ t('Education') }}</div>
      <div style="font-size:12px; line-height:1.6; color:#3C3C40;">
        {% for ed in r.education %}
        <b style="color:#151517;">{{ ed.degree }}</b><br>{{ ed.school }}{% if ed.school and ed.end %} · {% endif %}{{ ed.end }}{% if not loop.last %}<br>{% endif %}
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>

  <div style="box-sizing:border-box; position:absolute; inset-inline-start:332px; top:0; inset-inline-end:0; bottom:0; padding:46px 44px 34px 44px; display:flex; flex-direction:column; gap:24px;">
    {% if r.title %}
    <div style="align-self:flex-end; background:#151517; color:#ffffff; border-radius:999px; padding:11px 30px; white-space:nowrap; font-family:Archivo,sans-serif; font-weight:900; font-size:18px; letter-spacing:1.5px; text-transform:uppercase;">{{ r.title }}</div>
    {% endif %}

    {% if r.achievements %}
    <div style="display:grid; grid-auto-flow:column; grid-auto-columns:minmax(0,1fr); gap:12px; border-top:1px solid #DEDEDE; border-bottom:1px solid #DEDEDE; padding:12px 0;">
      {% for a in r.achievements %}
      <div>
        <div style="font-family:Archivo,sans-serif; font-weight:900; font-size:25px; color:#151517;">{{ a.metric }}</div>
        <div style="font-size:9px; letter-spacing:1px; font-weight:700; text-transform:uppercase; color:#6B6B70; margin-top:4px;">{{ a.label }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if r.experience %}
    <div>
      <div class="cv-section" style="{{ SH }} margin-bottom:14px;">{{ t('Work Experience') }}</div>
      <div style="display:flex; flex-direction:column; gap:18px;">
        {% for job in r.experience %}
        <div>
          <div style="font-weight:700; font-size:14px;">{{ job.role }}</div>
          {% if job.company or job.location or job.start or job.end %}
          <div style="font-size:11.5px; color:#6B6B70; margin:2px 0 7px;">{{ job.company }}{% if job.company and job.location %} · {% endif %}{{ job.location }}{% if (job.company or job.location) and (job.start or job.end) %} · {% endif %}{{ job.start }}{% if job.start and job.end %} – {% endif %}{{ job.end }}</div>
          {% endif %}
          {% if job.bullets %}
          <ul style="margin:0; padding-inline-start:16px; font-size:12px; line-height:1.6; color:#3C3C40;">
            {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
          </ul>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
</div>
