{# Modern Template 17 — Two-Tone Ribbon · two-column · ribbon banners, ring skills
   Ported from block <!-- 17 --> / id="t17" of "Resume Templates Coded.dc.html".
   Locked spec: #F4F2EC page, #E5E8F5 sidebar with a #003366 navy header block
   (Montserrat 900 44px name); navy ribbon banners bleeding off the sidebar's
   left edge; white right column with a pale-blue photo band, a navy #003366
   stat band, dotted timelines for Education and Experience, and a 4-up conic
   ring grid for Skills (percent in the centre, name + level below as real text).

   Divergences from the supplied reference:
     1. Palette — navy #003366 accent on #F4F2EC / #E5E8F5, locked here.
     2. Type — Montserrat display + Montserrat body, Archivo for stat numerals.
     3. Decorative glyphs in the section heads (✆ ✉ ◉ 🎓 💼 ★) dropped.
     4. The reference lists skills twice (a plain sidebar list + body rings); the
        data model has one list, so it renders once as the body rings. The
        sidebar carries Contact / Languages / Tools / Certifications instead.
     5. Education and Experience bodies render the bullet list as a running
        paragraph (the reference paragraph style); dates use an en dash.
     6. Section gaps trimmed (body 18->12, sidebar 26->18), photo band
        240->190, ring size 68->54 and timeline entry gaps 14->10 to seat the
        shared sample (right column was ~167px over at the reference values). #}
{% import "_macros.j2" as m %}
{% set RIBBON = "background:#003366; color:#ffffff; font-weight:800; font-size:19px; padding:9px 20px; margin-inline-start:-34px;" %}
{% set BH = "font-family:Montserrat,sans-serif; font-weight:700; font-size:22px; color:#111111;" %}
<div class="tpl" style="box-sizing:border-box; width:850px; height:1100px; display:flex; background:#f4f2ec; font-family:Montserrat,sans-serif; overflow:hidden;">

  <div style="width:360px; flex-shrink:0; display:flex; flex-direction:column; background:#e5e8f5;">
    <div style="background:#003366; color:#ffffff; padding:40px 34px 26px;">
      <div class="cv-name" style="font-weight:900; font-size:44px; letter-spacing:2px; line-height:1; text-transform:uppercase;">{{ r.name }}</div>
      {% if r.title %}<div style="font-size:17px; opacity:0.8; margin-top:8px;">{{ r.title }}</div>{% endif %}
      {% if r.summary %}<p style="font-size:12px; line-height:1.6; margin:16px 0 0; opacity:0.95;">{{ r.summary }}</p>{% endif %}
    </div>
    <div style="padding:0 34px; display:flex; flex-direction:column; gap:18px; margin-top:28px;">
      {% set c = r.contact %}
      {% if c.phone or c.email or c.address or c.site or c.social %}
      <div>
        <div class="cv-section" style="{{ RIBBON }}">{{ t('CONTACT') }}</div>
        <div style="display:flex; flex-direction:column; gap:9px; margin-top:16px; font-size:12.5px; color:#111111;">
          {% if c.phone %}<div>{{ c.phone }}</div>{% endif %}
          {% if c.email %}<div style="overflow-wrap:anywhere;">{{ c.email }}</div>{% endif %}
          {% if c.address %}<div>{{ c.address }}</div>{% endif %}
          {% if c.site %}<div style="overflow-wrap:anywhere;">{{ c.site }}</div>{% endif %}
          {% for s in c.social %}{% if s.label %}<div style="overflow-wrap:anywhere;">{{ s.label }}</div>{% endif %}{% endfor %}
        </div>
      </div>
      {% endif %}

      {% if r.languages %}
      <div>
        <div class="cv-section" style="{{ RIBBON }}">{{ t('LANGUAGES') }}</div>
        <div style="margin-top:16px; display:flex; flex-direction:column; gap:6px; font-size:12.5px; color:#111111;">
          {% for l in r.languages %}<div>{{ l.name }} — {{ l.level }}</div>{% endfor %}
        </div>
      </div>
      {% endif %}

      {% if r.tools %}
      <div>
        <div class="cv-section" style="{{ RIBBON }}">{{ t('TOOLS') }}</div>
        <div style="margin-top:16px; font-size:12.5px; color:#111111; line-height:1.6;">{{ r.tools | join(" · ") }}</div>
      </div>
      {% endif %}

      {% if r.recognition %}
      <div>
        <div class="cv-section" style="{{ RIBBON }}">{{ t('CERTIFICATIONS') }}</div>
        <div style="margin-top:16px; display:flex; flex-direction:column; gap:8px; font-size:12.5px; color:#111111;">
          {% for rec in r.recognition %}<div><b>{{ rec.title }}</b>{% if rec.detail %}<br>{{ rec.detail }}{% endif %}</div>{% endfor %}
        </div>
      </div>
      {% endif %}
    </div>
  </div>

  <div style="flex:1; min-width:0; background:#ffffff; color:#333333; display:flex; flex-direction:column;">
    <div style="height:190px; flex-shrink:0; background:#e5e8f5; overflow:hidden; display:flex; align-items:center; justify-content:center; color:#333333; font-size:13px;">
      {% if r.photo_url %}<img src="{{ r.photo_url }}" alt="" style="width:100%; height:100%; object-fit:cover; display:block;">{% else %}{{ t('Photo') }}{% endif %}
    </div>
    <div style="padding:15px 36px; display:flex; flex-direction:column; gap:10px;">

      {% if r.achievements %}
      <div style="display:grid; grid-auto-flow:column; grid-auto-columns:minmax(0,1fr); gap:12px; border-top:1px solid #cccccc; border-bottom:1px solid #cccccc; padding:8px 0;">
        {% for a in r.achievements %}
        {% if a.metric %}
        <div style="text-align:center;">
          <div style="font-family:Archivo,sans-serif; font-weight:900; font-size:25px; line-height:1; color:#003366;">{{ a.metric }}</div>
          <div style="font-size:9px; letter-spacing:1px; font-weight:700; text-transform:uppercase; color:#555555; margin-top:5px;">{{ a.label }}</div>
        </div>
        {% endif %}
        {% endfor %}
      </div>
      {% endif %}

      {% if r.education %}
      <div>
        <div class="cv-section" style="{{ BH }} margin-bottom:8px;">{{ t('Education') }}</div>
        <div style="height:1px; background:#cccccc; margin-bottom:10px;"></div>
        <div style="display:flex; flex-direction:column; gap:10px;">
          {% for ed in r.education %}
          <div style="display:flex; gap:16px;">
            <span style="width:12px; height:12px; border-radius:50%; background:#003366; margin-top:4px; flex-shrink:0;"></span>
            <div style="min-width:0;">
              <div style="display:flex; justify-content:space-between; align-items:baseline; gap:12px;"><div style="font-size:15px; color:#111111;">{{ ed.degree }}</div>{% if ed.start or ed.end %}<div style="font-size:12.5px; color:#777777; white-space:nowrap;">{{ ed.start }}{% if ed.start and ed.end %} – {% endif %}{{ ed.end }}</div>{% endif %}</div>
              {% if ed.school %}<div style="font-size:12.5px; color:#555555; margin:2px 0 5px;">{{ ed.school }}</div>{% endif %}
              {% if ed.bullets %}<p style="font-size:12px; line-height:1.55; color:#444444; margin:0;">{{ ed.bullets | join(" ") }}</p>{% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if r.experience %}
      <div>
        <div class="cv-section" style="{{ BH }} margin-bottom:8px;">{{ t('Experience') }}</div>
        <div style="height:1px; background:#cccccc; margin-bottom:10px;"></div>
        <div style="display:flex; flex-direction:column; gap:10px;">
          {% for job in r.experience %}
          <div style="display:flex; gap:16px;">
            <span style="width:12px; height:12px; border-radius:50%; background:#003366; margin-top:4px; flex-shrink:0;"></span>
            <div style="min-width:0;">
              <div style="display:flex; justify-content:space-between; align-items:baseline; gap:12px;"><div style="font-size:15px; color:#111111;">{{ job.role }}</div>{% if job.start or job.end %}<div style="font-size:12.5px; color:#777777; white-space:nowrap;">{{ job.start }}{% if job.start and job.end %} – {% endif %}{{ job.end }}</div>{% endif %}</div>
              {% if job.company or job.location %}<div style="font-size:12.5px; color:#555555; margin:2px 0 5px;">{{ job.company }}{% if job.company and job.location %} · {{ job.location }}{% elif job.location %}{{ job.location }}{% endif %}</div>{% endif %}
              {% if job.bullets %}<p style="font-size:12px; line-height:1.55; color:#444444; margin:0;">{{ job.bullets | join(" ") }}</p>{% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if r.skills %}
      <div>
        <div class="cv-section" style="{{ BH }} margin-bottom:8px;">{{ t('Skills') }}</div>
        <div style="height:1px; background:#cccccc; margin-bottom:12px;"></div>
        <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:12px;">
          {% for sk in r.skills %}
          {{ m.skill_ring(sk, {'size': 54, 'hole': 39, 'pct_size': 11,
             'ring': '#003366', 'track': '#dce6f5',
             'name_css': 'font-size:12px; color:#333333; text-align:center;',
             'level_css': 'font-size:10px; color:#5f6b7a; text-align:center;'}) }}
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</div>
