# CVStand — deployment settings.
#
# Copy the values into the hosting dashboard (Railway: Variables tab). This
# file is committed as documentation and must NEVER hold a real secret.
#
# Renamed from RESUMECRAFT_* to CVSTAND_* on 2026-09-14. An old-style name set
# in the dashboard is now silently ignored, which is the dangerous failure for
# the first variable below -- so check the spelling rather than assuming a
# setting took.


# ── REQUIRED, and the app refuses to boot without it ──────────────────────

# Flask signs the session cookie with this, and the cookie carries WHO YOU
# ARE. A known key is not a weak password, it is the ability to mint a session
# as any user. `create_app()` raises InsecureDeployment if this is still the
# shipped default while CVSTAND_SERVER_STORE=0.
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-your-own-do-not-use-this-line

# THE SETTING THAT MATTERS MOST ON A PUBLIC URL.
#
# 1 (default) = the server keeps ONE résumé at data/resume.json. Correct for a
# tool on your own machine; catastrophic on a public URL, where two visitors
# read and overwrite each other's document with no bug anywhere in the code.
# It is not an authz gap that accounts would close -- it is one file where
# there needs to be one per person.
#
# 0 = the browser owns the résumé (localStorage) and the server is a pure
# render-and-export service that keeps nothing. Set it to 0 for any deployment
# more than one person can reach.
CVSTAND_SERVER_STORE=0


# ── REQUIRED on a container platform ──────────────────────────────────────

# Where the accounts database lives. On Railway this MUST be the mount path of
# a persistent volume: a container filesystem is ephemeral, so without one
# every deploy silently deletes every account that has ever been created.
CVSTAND_DATA_DIR=/data

# How many proxies sit in front of the app; Railway/Render/Fly each add one.
#
# Leave UNSET for a direct-to-Flask deployment. X-Forwarded-For is a request
# HEADER: trusting it when nothing strips it lets any client mint itself a
# fresh rate-limit bucket per request, which is strictly worse than ignoring
# it. Set to 1 only because the platform's router is genuinely in front.
CVSTAND_TRUSTED_PROXIES=1


# ── CAPACITY — tune to the instance size ─────────────────────────────────

# Concurrent PDF renders. Each one launches a WHOLE Chromium, so this is the
# setting that decides whether a burst gets the container OOM-killed. Keep it
# at 1 on anything under 2 GB. It is a per-process semaphore, which is why the
# Dockerfile runs a single gunicorn worker with threads -- extra workers
# multiply the real cap instead of respecting it.
CVSTAND_RENDER_CONCURRENCY=1

# How long a request will queue for a render slot before giving up (503). A
# client holding a connection open for two minutes is itself a resource.
CVSTAND_RENDER_QUEUE_WAIT=20

# Per-client rate limits, requests per minute.
CVSTAND_LIMIT_PDF=10
CVSTAND_LIMIT_DOCX=20
CVSTAND_LIMIT_PHOTO=20
CVSTAND_LIMIT_RENDER=120
CVSTAND_LIMIT_ASSIST=15
CVSTAND_LIMIT_AUTH=10


# ── OPTIONAL ──────────────────────────────────────────────────────────────

# The AI writing assistant (app/assist.py). Leave UNSET and the feature
# answers 503 while the rest of the app is unaffected -- which is how it is
# meant to ship until Stage 3 turns payment on. Setting it costs money per
# request, so set it deliberately.
#
# app/assist.py reads EITHER name, because the Anthropic SDK resolves either.
# Set one, not both.
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
