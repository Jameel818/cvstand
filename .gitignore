!word_masters/*.docx
.DS_Store
tests/e2e/artifacts/
junit.xml

# Accounts database - local state, and it would be a credential leak in a
# public repo (scrypt hashes, but still every registered address).
data/*.db

# Deployment secrets. NEVER commit a real SECRET_KEY or ANTHROPIC_API_KEY.
.env
.env.*
!.env.example

# Build / CI artifacts
junit_e2e.xml
screenshots/
*.PNG
!app/static/**/*.png
# The pixel gate's baselines. `*.PNG` is meant for the screenshots that pile up
# in the project root, but git's ignore matching is case-insensitive on Windows,
# so it was also swallowing all 49 of these: they existed on one machine and
# were tracked NOWHERE. A baseline that is not versioned cannot gate anything —
# a fresh clone has none, `golden.py --pixels` then writes whatever the code
# currently renders, and the gate passes by having nothing to compare against.
# That is this repo's signature failure: a check that looks green and is inert.
!tests/golden/pixels/*.png

# Runtime state that lives in a TRACKED path. `data/meta.json` records which
# template was last selected, so it is rewritten by ordinary use and shows up
# as a modification after almost every run — noise in every `git status`, and
# a file whose committed contents mean nothing.
data/meta.json
data/resume.json

# Font SOURCES, not shipped assets. 27 MB, and two reasons it stays out:
#
#   Fonts/Thmanyah/     the .otf files that tools/outline_text.py --build-hero
#                       reads. Its licence forbids "redistribute, share,
#                       upload, host" — and pushing to a git remote is
#                       uploading. A fresh clone cannot rebuild the outlines
#                       without copying this folder in by hand.
#   Fonts/Nice fonts/   fourteen commercial retail faces with ZERO licence
#                       files between them. See FONTS.md.
Fonts/
